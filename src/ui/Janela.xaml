<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Otimizador Vinicius" Width="1240" Height="800" MinWidth="1020" MinHeight="660"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Fundo}" Foreground="{DynamicResource Texto}"
        FontFamily="{DynamicResource FonteTexto}" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <FontFamily x:Key="Icones">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <FontFamily x:Key="FonteTexto">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="FonteTitulo">Segoe UI Variable Display, Segoe UI</FontFamily>
        <FontFamily x:Key="FonteCodigo">Cascadia Mono, Consolas</FontFamily>

        <!-- Paleta (tema escuro). A janela troca estes pincéis no tema claro. -->
        <SolidColorBrush x:Key="Fundo" Color="#0E1117"/>
        <SolidColorBrush x:Key="Palco" Color="#131720"/>
        <SolidColorBrush x:Key="Superficie" Color="#1A1F29"/>
        <SolidColorBrush x:Key="Superficie2" Color="#232A36"/>
        <SolidColorBrush x:Key="SuperficieHover" Color="#2B3341"/>
        <SolidColorBrush x:Key="Borda" Color="#2A3140"/>
        <SolidColorBrush x:Key="Texto" Color="#E8ECF3"/>
        <SolidColorBrush x:Key="TextoSec" Color="#9AA4B5"/>
        <SolidColorBrush x:Key="TextoFraco" Color="#5D6778"/>
        <SolidColorBrush x:Key="Acento" Color="#2DD4BF"/>
        <SolidColorBrush x:Key="AcentoSuave" Color="#262DD4BF"/>
        <SolidColorBrush x:Key="SobreAcento" Color="#04211D"/>
        <SolidColorBrush x:Key="Ok" Color="#34D399"/>
        <SolidColorBrush x:Key="OkSuave" Color="#2634D399"/>
        <SolidColorBrush x:Key="Aviso" Color="#FBBF24"/>
        <SolidColorBrush x:Key="AvisoSuave" Color="#26FBBF24"/>
        <SolidColorBrush x:Key="Erro" Color="#F87171"/>
        <SolidColorBrush x:Key="ErroSuave" Color="#26F87171"/>
        <SolidColorBrush x:Key="Info" Color="#60A5FA"/>
        <SolidColorBrush x:Key="InfoSuave" Color="#2660A5FA"/>
        <SolidColorBrush x:Key="Scrim" Color="#A6000000"/>
        <SolidColorBrush x:Key="Serie1" Color="#3987E5"/>
        <SolidColorBrush x:Key="Serie2" Color="#D95926"/>
        <SolidColorBrush x:Key="Grade" Color="#2A3140"/>
        <LinearGradientBrush x:Key="AcentoGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0D9488" Offset="0"/>
            <GradientStop Color="#2563EB" Offset="1"/>
        </LinearGradientBrush>

        <!-- Texto -->
        <Style x:Key="Titulo" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource FonteTitulo}"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Subtitulo" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextoSec}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Secao" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,28,0,12"/>
        </Style>
        <Style x:Key="Rotulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextoSec}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Corpo" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="21"/>
        </Style>
        <Style x:Key="CorpoSec" TargetType="TextBlock" BasedOn="{StaticResource Corpo}">
            <Setter Property="Foreground" Value="{DynamicResource TextoSec}"/>
        </Style>
        <Style x:Key="Icone" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icones}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="IconeBtn" TargetType="TextBlock" BasedOn="{StaticResource Icone}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- Cartão -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Superficie}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Borda}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Superficie2}"/>
            <Setter Property="CornerRadius" Value="99"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <!-- Botões -->
        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
            <Setter Property="Background" Value="{DynamicResource Superficie2}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Borda}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="E"/></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="E" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.08"/>
                                    <DoubleAnimation Storyboard.TargetName="E" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.08"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="E" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/>
                                    <DoubleAnimation Storyboard.TargetName="E" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BtnPrimario" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{DynamicResource AcentoGrad}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.9"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BtnSecundario" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SuperficieHover}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BtnFantasma" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextoSec}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Superficie2}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BtnPerigo" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{DynamicResource ErroSuave}"/>
            <Setter Property="Foreground" Value="{DynamicResource Erro}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BtnLink" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource Acento}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="Transparent" Padding="6,3" CornerRadius="6">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource AcentoSuave}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BtnJanela" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="{DynamicResource TextoSec}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Superficie2}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BtnFechar" TargetType="Button" BasedOn="{StaticResource BtnJanela}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cartão clicável (ações rápidas e atalhos) -->
        <Style x:Key="CartaoAcao" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{DynamicResource Superficie}" BorderBrush="{DynamicResource Borda}" BorderThickness="1"
                                CornerRadius="14" Padding="18" Margin="{TemplateBinding Padding}">
                            <Border.RenderTransform><TranslateTransform x:Name="T"/></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Acento}"/>
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="T" Storyboard.TargetProperty="Y" To="-3" Duration="0:0:0.15"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="T" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.15"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconeCirculo" TargetType="Border">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource AcentoSuave}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- Navegação lateral -->
        <Style x:Key="Nav" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextoSec}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="GroupName" Value="nav"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="F" Background="Transparent" CornerRadius="10" Height="40" Margin="0,1">
                            <Grid>
                                <Border x:Name="Marca" Width="3" Height="18" CornerRadius="2" Background="{DynamicResource AcentoGrad}"
                                        HorizontalAlignment="Left" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform><ScaleTransform x:Name="ME" ScaleY="0.2"/></Border.RenderTransform>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource Icones}" FontSize="17" Width="22" VerticalAlignment="Center"/>
                                    <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="F" Property="Background" Value="{DynamicResource Superficie2}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="F" Property="Background" Value="{DynamicResource Superficie}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Marca" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                    <DoubleAnimation Storyboard.TargetName="ME" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.3">
                                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Marca" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                    <DoubleAnimation Storyboard.TargetName="ME" Storyboard.TargetProperty="ScaleY" To="0.2" Duration="0:0:0.15"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pílulas (perfis, ferramentas) -->
        <Style x:Key="Pill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextoSec}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="B" CornerRadius="99" Padding="14,7" Background="{DynamicResource Superficie}" BorderBrush="{DynamicResource Borda}" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Superficie2}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource AcentoSuave}"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Acento}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Acento}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Segmento" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextoSec}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="B" CornerRadius="8" Padding="14,6" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Texto}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Superficie}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CartaoEscolha" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="B" CornerRadius="12" Padding="14,12" Background="{DynamicResource Superficie2}" BorderBrush="Transparent" BorderThickness="2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Borda}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource AcentoSuave}"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Acento}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Caixa de seleção -->
        <Style x:Key="Caixa" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid x:Name="R" Background="Transparent">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border x:Name="Q" Width="20" Height="20" CornerRadius="6" BorderThickness="1.5" BorderBrush="{DynamicResource TextoFraco}" Background="Transparent" VerticalAlignment="Center">
                                <TextBlock x:Name="V" Text="&#xE73E;" FontFamily="{StaticResource Icones}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SobreAcento}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform><ScaleTransform x:Name="VE" ScaleX="0.3" ScaleY="0.3"/></TextBlock.RenderTransform>
                                </TextBlock>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Q" Property="BorderBrush" Value="{DynamicResource Acento}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Q" Property="Background" Value="{DynamicResource Acento}"/>
                                <Setter TargetName="Q" Property="BorderBrush" Value="{DynamicResource Acento}"/>
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="V" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1"/>
                                    <DoubleAnimation Storyboard.TargetName="VE" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.25">
                                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="VE" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.25">
                                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="V" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                                    <DoubleAnimation Storyboard.TargetName="VE" Storyboard.TargetProperty="ScaleX" To="0.3" Duration="0:0:0.1"/>
                                    <DoubleAnimation Storyboard.TargetName="VE" Storyboard.TargetProperty="ScaleY" To="0.3" Duration="0:0:0.1"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="R" Property="Opacity" Value="0.35"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Interruptor (liga/desliga) -->
        <Style x:Key="Interruptor" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border x:Name="Trilho" Width="40" Height="22" CornerRadius="11" Background="{DynamicResource Superficie2}" BorderBrush="{DynamicResource TextoFraco}" BorderThickness="1" VerticalAlignment="Center">
                                <Ellipse x:Name="Bola" Width="12" Height="12" Fill="{DynamicResource TextoSec}" HorizontalAlignment="Left" Margin="5,0,0,0">
                                    <Ellipse.RenderTransform><TranslateTransform x:Name="BT"/></Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Trilho" Property="Background" Value="{DynamicResource Acento}"/>
                                <Setter TargetName="Trilho" Property="BorderBrush" Value="{DynamicResource Acento}"/>
                                <Setter TargetName="Bola" Property="Fill" Value="{DynamicResource SobreAcento}"/>
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="BT" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.18">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="BT" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Campos de texto -->
        <Style x:Key="Campo" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Texto}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Acento}"/>
            <Setter Property="Background" Value="{DynamicResource Superficie2}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Borda}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <Grid>
                                <TextBlock x:Name="Dica" Text="{TemplateBinding Tag}" Foreground="{DynamicResource TextoFraco}" Margin="{TemplateBinding Padding}" Padding="3,0,0,0"
                                           Visibility="Collapsed" IsHitTestVisible="False" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value=""><Setter TargetName="Dica" Property="Visibility" Value="Visible"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource TextoFraco}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Acento}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CampoCodigo" TargetType="TextBox" BasedOn="{StaticResource Campo}">
            <Setter Property="FontFamily" Value="{DynamicResource FonteCodigo}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Foreground" Value="{DynamicResource TextoSec}"/>
        </Style>

        <!-- Barra de progresso -->
        <Style x:Key="Barra" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="4" Background="{DynamicResource Superficie2}"/>
                            <Border x:Name="PART_Indicator" CornerRadius="4" Background="{DynamicResource AcentoGrad}" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Itens da lista de ajustes -->
        <Style x:Key="ItemLista" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="B" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Superficie2}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource AcentoSuave}"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Acento}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Barras de rolagem finas -->
        <Style x:Key="PolegarScroll" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="T" CornerRadius="4" Background="{DynamicResource TextoFraco}" Opacity="0.45"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="T" Property="Opacity" Value="1"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb><Thumb Style="{StaticResource PolegarScroll}" Margin="2,2"/></Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="MinHeight" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.Thumb><Thumb Style="{StaticResource PolegarScroll}" Margin="2,2"/></Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Dicas (tooltip) -->
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{DynamicResource Superficie2}" BorderBrush="{DynamicResource Borda}" BorderThickness="1" CornerRadius="8" Padding="10,7" MaxWidth="360">
                            <ContentPresenter>
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Expansor (perguntas frequentes e histórico) -->
        <Style x:Key="Sanfona" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{DynamicResource Superficie}" BorderBrush="{DynamicResource Borda}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,8">
                            <StackPanel>
                                <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" Padding="18,14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="Seta" Grid.Column="1" Text="&#xE70D;" FontFamily="{StaticResource Icones}" FontSize="12"
                                                               Foreground="{DynamicResource TextoSec}" VerticalAlignment="Center" Margin="12,0,0,0" RenderTransformOrigin="0.5,0.5"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Seta" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="False"/>
                                </ToggleButton>
                                <ContentPresenter x:Name="Conteudo" Visibility="Collapsed" Margin="18,0,18,16"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Conteudo" Property="Visibility" Value="Visible"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pílula de estado de um ajuste -->
        <Style x:Key="PilulaEstado" TargetType="Border">
            <Setter Property="CornerRadius" Value="99"/>
            <Setter Property="Padding" Value="9,2"/>
            <Setter Property="Background" Value="{DynamicResource Superficie2}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextoSec}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Estado}" Value="aplicado">
                    <Setter Property="Background" Value="{DynamicResource OkSuave}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Ok}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Estado}" Value="parcial">
                    <Setter Property="Background" Value="{DynamicResource AvisoSuave}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Aviso}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Estado}" Value="acao">
                    <Setter Property="Background" Value="{DynamicResource InfoSuave}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Info}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Estado}" Value="erro">
                    <Setter Property="Background" Value="{DynamicResource ErroSuave}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Erro}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Estado}" Value="verificando">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Pulso"><Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.7" AutoReverse="True" RepeatBehavior="Forever"/>
                        </Storyboard></BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="Pulso"/></DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PontoRisco" TargetType="Ellipse">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Height" Value="9"/>
            <Setter Property="Fill" Value="{DynamicResource Ok}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Risco}" Value="moderado"><Setter Property="Fill" Value="{DynamicResource Aviso}"/></DataTrigger>
                <DataTrigger Binding="{Binding Risco}" Value="avancado"><Setter Property="Fill" Value="{DynamicResource Erro}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PilulaRisco" TargetType="Border">
            <Setter Property="CornerRadius" Value="99"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Background" Value="{DynamicResource OkSuave}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Ok}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Risco}" Value="moderado">
                    <Setter Property="Background" Value="{DynamicResource AvisoSuave}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Aviso}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Risco}" Value="avancado">
                    <Setter Property="Background" Value="{DynamicResource ErroSuave}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Erro}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Ícone de status por nível (alertas, histórico, testes) -->
        <Style x:Key="IconeNivel" TargetType="TextBlock" BasedOn="{StaticResource Icone}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Text" Value="&#xE946;"/>
            <Setter Property="Foreground" Value="{DynamicResource Info}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Nivel}" Value="ok"><Setter Property="Text" Value="&#xE73E;"/><Setter Property="Foreground" Value="{DynamicResource Ok}"/></DataTrigger>
                <DataTrigger Binding="{Binding Nivel}" Value="medio"><Setter Property="Text" Value="&#xE7BA;"/><Setter Property="Foreground" Value="{DynamicResource Aviso}"/></DataTrigger>
                <DataTrigger Binding="{Binding Nivel}" Value="aviso"><Setter Property="Text" Value="&#xE7BA;"/><Setter Property="Foreground" Value="{DynamicResource Aviso}"/></DataTrigger>
                <DataTrigger Binding="{Binding Nivel}" Value="alto"><Setter Property="Text" Value="&#xE783;"/><Setter Property="Foreground" Value="{DynamicResource Erro}"/></DataTrigger>
                <DataTrigger Binding="{Binding Nivel}" Value="erro"><Setter Property="Text" Value="&#xE711;"/><Setter Property="Foreground" Value="{DynamicResource Erro}"/></DataTrigger>
                <DataTrigger Binding="{Binding Nivel}" Value="ignorado"><Setter Property="Text" Value="&#xE711;"/><Setter Property="Foreground" Value="{DynamicResource TextoSec}"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Cartão de ajuste (páginas Placa de vídeo, Notebook e Serviços) -->
        <DataTemplate x:Key="ModeloCartaoAjuste">
            <Border x:Name="C" Background="{DynamicResource Superficie}" BorderBrush="{DynamicResource Borda}" BorderThickness="1" CornerRadius="14" Padding="16,13" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <CheckBox Style="{StaticResource Caixa}" IsChecked="{Binding Selecionado, Mode=TwoWay}" IsEnabled="{Binding Habilitado}" VerticalAlignment="Top" Margin="0,2,14,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Resumo}" Foreground="{DynamicResource TextoSec}" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding EstadoDetalhe}" Foreground="{DynamicResource Acento}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0"
                                   Visibility="{Binding TemEstadoDetalhe, Converter={StaticResource B2V}}"/>
                        <Grid Margin="0,6,0,0" Visibility="{Binding TemAtencao, Converter={StaticResource B2V}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icone}" FontSize="12" Foreground="{DynamicResource Aviso}" VerticalAlignment="Top" Margin="0,2,8,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding Atencao}" Foreground="{DynamicResource Aviso}" FontSize="12.5" TextWrapping="Wrap"/>
                        </Grid>
                        <TextBlock Text="{Binding Motivo}" Foreground="{DynamicResource TextoSec}" FontStyle="Italic" FontSize="12.5" TextWrapping="Wrap" Margin="0,5,0,0"
                                   Visibility="{Binding TemMotivo, Converter={StaticResource B2V}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icone}" FontSize="12" Foreground="{DynamicResource TextoFraco}" Margin="0,0,10,0"
                                   Visibility="{Binding TemReinicio, Converter={StaticResource B2V}}" ToolTip="{Binding ReinicioTexto}"/>
                        <Ellipse Style="{StaticResource PontoRisco}" Margin="0,0,10,0" ToolTip="{Binding RiscoDica}"/>
                        <Border Style="{StaticResource PilulaEstado}">
                            <TextBlock Text="{Binding EstadoTexto}" FontSize="11.5" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Selecionado}" Value="True"><Setter TargetName="C" Property="BorderBrush" Value="{DynamicResource Acento}"/></DataTrigger>
                <DataTrigger Binding="{Binding Habilitado}" Value="False"><Setter TargetName="C" Property="Opacity" Value="0.55"/></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Etapa da verificação -->
        <DataTemplate x:Key="ModeloEtapa">
            <Grid Margin="0,7">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="Ico" Text="&#xE9F3;" Style="{StaticResource Icone}" FontSize="15" Foreground="{DynamicResource TextoFraco}" Width="22" TextAlignment="Center"
                           Margin="0,0,12,0" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform><RotateTransform/></TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock x:Name="T" Grid.Column="1" Text="{Binding Titulo}" Foreground="{DynamicResource TextoSec}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding Extra}" Foreground="{DynamicResource TextoFraco}" FontSize="12.5" VerticalAlignment="Center"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Nivel}" Value="rodando">
                    <Setter TargetName="Ico" Property="Text" Value="&#xE895;"/>
                    <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource Acento}"/>
                    <Setter TargetName="T" Property="Foreground" Value="{DynamicResource Texto}"/>
                    <Setter TargetName="T" Property="FontWeight" Value="SemiBold"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="GiroEtapa"><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Ico" Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/>
                        </Storyboard></BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="GiroEtapa"/></DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding Nivel}" Value="ok">
                    <Setter TargetName="Ico" Property="RenderTransform"><Setter.Value><RotateTransform Angle="0"/></Setter.Value></Setter>
                    <Setter TargetName="Ico" Property="Text" Value="&#xE73E;"/>
                    <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource Ok}"/>
                    <Setter TargetName="T" Property="Foreground" Value="{DynamicResource Texto}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Nivel}" Value="medio">
                    <Setter TargetName="Ico" Property="RenderTransform"><Setter.Value><RotateTransform Angle="0"/></Setter.Value></Setter>
                    <Setter TargetName="Ico" Property="Text" Value="&#xE7BA;"/>
                    <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource Aviso}"/>
                    <Setter TargetName="T" Property="Foreground" Value="{DynamicResource Texto}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Nivel}" Value="alto">
                    <Setter TargetName="Ico" Property="RenderTransform"><Setter.Value><RotateTransform Angle="0"/></Setter.Value></Setter>
                    <Setter TargetName="Ico" Property="Text" Value="&#xE783;"/>
                    <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource Erro}"/>
                    <Setter TargetName="T" Property="Foreground" Value="{DynamicResource Texto}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Barra de progresso por categoria -->
        <DataTemplate x:Key="ModeloBarra">
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Titulo}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="13"/>
                <ProgressBar Grid.Column="1" Style="{StaticResource Barra}" Maximum="1" Value="{Binding Valor, Mode=OneWay}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding Texto}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextoSec}"/>
            </Grid>
        </DataTemplate>

        <!-- Item de saúde (verificação) -->
        <DataTemplate x:Key="ModeloSaude">
            <Border Background="{DynamicResource Superficie}" BorderBrush="{DynamicResource Borda}" BorderThickness="1" CornerRadius="12" Padding="16,11" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource IconeNivel}" Margin="0,2,14,0" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Texto}" Foreground="{DynamicResource TextoSec}" FontSize="12.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource BtnLink}" Tag="{Binding Tag}" Content="{Binding Extra}" Margin="12,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding TemExtra, Converter={StaticResource B2V}}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Raiz">
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================== Barra de título ===================== -->
        <Grid Grid.Row="0" Margin="16,0,6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource AcentoGrad}">
                    <TextBlock Text="&#xEC4A;" Style="{StaticResource Icone}" FontSize="15" Foreground="White" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Text="Otimizador Vinicius" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <Border Style="{StaticResource Chip}" Margin="10,0,0,0" Padding="8,1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtVersao" Text="v2.0" FontSize="11" Foreground="{DynamicResource TextoSec}"/>
                </Border>
            </StackPanel>
            <TextBlock x:Name="TxtBarraStatus" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextoSec}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnTema" Style="{StaticResource BtnJanela}" ToolTip="Alternar tema claro / escuro">
                    <TextBlock Text="&#xE790;" Style="{StaticResource Icone}" FontSize="14"/>
                </Button>
                <Button x:Name="BtnMinimizar" Style="{StaticResource BtnJanela}" ToolTip="Minimizar">
                    <TextBlock Text="&#xE921;" Style="{StaticResource Icone}" FontSize="10"/>
                </Button>
                <Button x:Name="BtnMaximizar" Style="{StaticResource BtnJanela}" ToolTip="Maximizar">
                    <TextBlock x:Name="IcoMaximizar" Text="&#xE922;" Style="{StaticResource Icone}" FontSize="10"/>
                </Button>
                <Button x:Name="BtnFechar" Style="{StaticResource BtnFechar}" ToolTip="Fechar">
                    <TextBlock Text="&#xE8BB;" Style="{StaticResource Icone}" FontSize="10"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===================== Corpo ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navegação -->
            <Grid Margin="12,8,12,16">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <RadioButton x:Name="NavInicio" Style="{StaticResource Nav}" Tag="&#xE80F;" Content="Início" IsChecked="True"/>
                    <RadioButton x:Name="NavVerificar" Style="{StaticResource Nav}" Tag="&#xE721;" Content="Verificar o PC"/>
                    <RadioButton x:Name="NavOtimizar" Style="{StaticResource Nav}" Tag="&#xE9E9;" Content="Otimizar"/>
                    <RadioButton x:Name="NavVideo" Style="{StaticResource Nav}" Tag="&#xE7F4;" Content="Placa de vídeo"/>
                    <RadioButton x:Name="NavNotebook" Style="{StaticResource Nav}" Tag="&#xE7F8;" Content="Notebook"/>
                    <RadioButton x:Name="NavServicos" Style="{StaticResource Nav}" Tag="&#xE9F5;" Content="Serviços"/>
                    <RadioButton x:Name="NavFerramentas" Style="{StaticResource Nav}" Tag="&#xE90F;" Content="Ferramentas"/>
                    <RadioButton x:Name="NavHistorico" Style="{StaticResource Nav}" Tag="&#xE81C;" Content="Histórico"/>
                    <RadioButton x:Name="NavAjuda" Style="{StaticResource Nav}" Tag="&#xE897;" Content="Ajuda"/>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <Border x:Name="AvisoConta" Background="{DynamicResource AvisoSuave}" CornerRadius="12" Padding="12,10" Margin="0,0,0,10" Visibility="Collapsed">
                        <TextBlock x:Name="TxtAvisoConta" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Aviso}"/>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="14,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F4;" Style="{StaticResource Icone}" FontSize="15" Foreground="{DynamicResource Acento}"/>
                                <TextBlock x:Name="TxtNavPc" Text="Este PC" FontWeight="SemiBold" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtNavWin" Text="Detectando..." FontSize="12" Foreground="{DynamicResource TextoSec}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Palco das páginas -->
            <Border Grid.Column="1" Background="{DynamicResource Palco}" CornerRadius="16,0,0,0" BorderBrush="{DynamicResource Borda}" BorderThickness="1,1,0,0">
                <Grid x:Name="Paginas" ClipToBounds="True">

                    <!-- ============ INÍCIO ============ -->
                    <ScrollViewer x:Name="PagInicio" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.RenderTransform><TranslateTransform/></ScrollViewer.RenderTransform>
                        <StackPanel Margin="36,30,36,36">
                            <TextBlock x:Name="TxtSaudacao" Style="{StaticResource Titulo}" Text="Olá!"/>
                            <TextBlock x:Name="TxtSaudacaoSub" Style="{StaticResource Subtitulo}" Text="Analisando o seu computador..."/>

                            <Grid Margin="0,24,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="290"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}" Padding="26,24">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Border Width="56" Height="56" CornerRadius="16" Background="{DynamicResource AcentoGrad}">
                                                <TextBlock x:Name="IcoPc" Text="&#xE7F4;" Style="{StaticResource Icone}" FontSize="26" Foreground="White" HorizontalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtPcNome" Text="..." FontFamily="{DynamicResource FonteTitulo}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="TxtPcWin" Text="" Foreground="{DynamicResource TextoSec}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Border x:Name="BadgeTier" Grid.Column="2" CornerRadius="99" Padding="14,6" Background="{DynamicResource AcentoGrad}" VerticalAlignment="Center" Opacity="0"
                                                    ToolTip="Classificação pelo processador, memória e tipo de disco do sistema.">
                                                <TextBlock x:Name="TxtTier" Text="" Foreground="White" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                        <WrapPanel x:Name="PainelChips" Margin="0,20,0,0"/>
                                        <TextBlock x:Name="TxtTierExplica" Style="{StaticResource CorpoSec}" FontSize="13" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Grid Width="150" Height="150">
                                            <Ellipse Stroke="{DynamicResource Superficie2}" StrokeThickness="12"/>
                                            <Path x:Name="ArcoProgresso" Stroke="{DynamicResource AcentoGrad}" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock x:Name="TxtAnelNumero" Text="–" FontFamily="{DynamicResource FonteTitulo}" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="TxtAnelLegenda" Text="verificando" FontSize="12" Foreground="{DynamicResource TextoSec}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="dos recomendados já aplicados" HorizontalAlignment="Center" Margin="0,10,0,12" Foreground="{DynamicResource TextoSec}"/>
                                        <Button x:Name="BtnVerAjustes" Style="{StaticResource BtnSecundario}" HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9E9;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Ver ajustes"/></StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Style="{StaticResource Secao}" Text="Ações rápidas"/>
                            <UniformGrid Columns="4" Margin="0,0,-12,0">
                                <Button x:Name="BtnAcaoOtimizar" Style="{StaticResource CartaoAcao}" Padding="0,0,12,0">
                                    <StackPanel>
                                        <Border Style="{StaticResource IconeCirculo}" Background="{DynamicResource AcentoGrad}"><TextBlock Text="&#xE945;" Style="{StaticResource Icone}" FontSize="18" Foreground="White" HorizontalAlignment="Center"/></Border>
                                        <TextBlock Text="Otimizar com 1 clique" FontWeight="SemiBold" Margin="0,14,0,2"/>
                                        <TextBlock x:Name="TxtAcaoOtimizarSub" Text="Escolhe o perfil ideal para este PC" FontSize="12.5" Foreground="{DynamicResource TextoSec}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnAcaoLimpar" Style="{StaticResource CartaoAcao}" Padding="0,0,12,0">
                                    <StackPanel>
                                        <Border Style="{StaticResource IconeCirculo}"><TextBlock Text="&#xE74D;" Style="{StaticResource Icone}" FontSize="18" Foreground="{DynamicResource Acento}" HorizontalAlignment="Center"/></Border>
                                        <TextBlock Text="Limpar temporários" FontWeight="SemiBold" Margin="0,14,0,2"/>
                                        <TextBlock x:Name="TxtAcaoLimparSub" Text="Calculando espaço..." FontSize="12.5" Foreground="{DynamicResource TextoSec}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnAcaoRelatorio" Style="{StaticResource CartaoAcao}" Padding="0,0,12,0">
                                    <StackPanel>
                                        <Border Style="{StaticResource IconeCirculo}"><TextBlock Text="&#xE9D9;" Style="{StaticResource Icone}" FontSize="18" Foreground="{DynamicResource Acento}" HorizontalAlignment="Center"/></Border>
                                        <TextBlock Text="Relatório do PC" FontWeight="SemiBold" Margin="0,14,0,2"/>
                                        <TextBlock Text="Peças, saúde dos discos e dicas de upgrade" FontSize="12.5" Foreground="{DynamicResource TextoSec}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnAcaoServidor" Style="{StaticResource CartaoAcao}" Padding="0,0,12,0">
                                    <StackPanel>
                                        <Border Style="{StaticResource IconeCirculo}"><TextBlock Text="&#xE968;" Style="{StaticResource Icone}" FontSize="18" Foreground="{DynamicResource Acento}" HorizontalAlignment="Center"/></Border>
                                        <TextBlock Text="Testar um servidor" FontWeight="SemiBold" Margin="0,14,0,2"/>
                                        <TextBlock Text="Confere se um endereço e uma porta respondem" FontSize="12.5" Foreground="{DynamicResource TextoSec}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>

                            <TextBlock Style="{StaticResource Secao}" Text="Pontos de atenção"/>
                            <TextBlock x:Name="TxtAlertasCarregando" Text="Analisando hardware..." Foreground="{DynamicResource TextoSec}"/>
                            <ItemsControl x:Name="ListaAlertas">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource IconeNivel}" Margin="0,0,14,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Texto}" Style="{StaticResource Corpo}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="2" Style="{StaticResource BtnLink}" Tag="{Binding Tag}" Content="{Binding Extra}" Margin="12,0,0,0"
                                                        Visibility="{Binding TemExtra, Converter={StaticResource B2V}}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ============ OTIMIZAR ============ -->
                    <Grid x:Name="PagOtimizar" Visibility="Collapsed">
                        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="36,30,36,0">
                            <TextBlock Style="{StaticResource Titulo}" Text="Otimizar"/>
                            <TextBlock Style="{StaticResource Subtitulo}" Text="Escolha um perfil ou marque item por item. Clique num ajuste para ver a explicação completa."/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="36,20,36,8">
                            <WrapPanel>
                                <StackPanel x:Name="PainelWindows" Margin="0,0,28,8">
                                    <TextBlock Style="{StaticResource Rotulo}" Text="WINDOWS"/>
                                    <Border Background="{DynamicResource Superficie2}" CornerRadius="10" Padding="3">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="RbWinAuto" Style="{StaticResource Segmento}" GroupName="win" Content="Automático" IsChecked="True"/>
                                            <RadioButton x:Name="RbWin10" Style="{StaticResource Segmento}" GroupName="win" Content="Windows 10"/>
                                            <RadioButton x:Name="RbWin11" Style="{StaticResource Segmento}" GroupName="win" Content="Windows 11"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Rotulo}" Text="PERFIL"/>
                                    <WrapPanel>
                                        <RadioButton x:Name="RbPerfilBasico" Style="{StaticResource Pill}" GroupName="perfil" Tag="basico" Content="Básico"/>
                                        <RadioButton x:Name="RbPerfilTrabalho" Style="{StaticResource Pill}" GroupName="perfil" Tag="trabalho" Content="Trabalho"/>
                                        <RadioButton x:Name="RbPerfilGamer" Style="{StaticResource Pill}" GroupName="perfil" Tag="gamer" Content="Gamer"/>
                                        <RadioButton x:Name="RbPerfilLeve" Style="{StaticResource Pill}" GroupName="perfil" Tag="leve" Content="PC simples"/>
                                        <RadioButton x:Name="RbPerfilNenhum" Style="{StaticResource Pill}" GroupName="perfil" Tag="personalizado" Content="Personalizado" IsChecked="True"/>
                                    </WrapPanel>
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock x:Name="TxtPerfilDescricao" Foreground="{DynamicResource TextoSec}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,12"/>
                            <Border x:Name="BannerWin" Background="{DynamicResource AvisoSuave}" CornerRadius="10" Padding="12,8" Margin="0,0,0,12" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icone}" Foreground="{DynamicResource Aviso}" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="TxtBannerWin" Foreground="{DynamicResource Aviso}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid>
                                    <TextBox x:Name="TxtBusca" Style="{StaticResource Campo}" Tag="Buscar ajuste (ex.: mouse, bing, energia)" Padding="36,9,12,9"/>
                                    <TextBlock Text="&#xE721;" Style="{StaticResource Icone}" Foreground="{DynamicResource TextoFraco}" Margin="13,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                                </Grid>
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0">
                                    <CheckBox x:Name="ChkSoPendentes" Style="{StaticResource Interruptor}" Content="Só o que falta" Margin="0,4,18,4" Foreground="{DynamicResource TextoSec}"/>
                                    <CheckBox x:Name="ChkAvancado" Style="{StaticResource Interruptor}" Content="Modo avançado" Margin="0,4,0,4" Foreground="{DynamicResource TextoSec}"
                                              ToolTip="Mostra os detalhes técnicos (chaves do registro e comandos), a escolha manual do Windows e os ajustes avançados."/>
                                </WrapPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button x:Name="BtnImportarPerfil" Style="{StaticResource BtnFantasma}" Padding="10,9" ToolTip="Carrega um perfil (.json) exportado de outro PC e marca os mesmos ajustes.">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E5;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Importar"/></StackPanel>
                                    </Button>
                                    <Button x:Name="BtnExportarPerfil" Style="{StaticResource BtnFantasma}" Padding="10,9" ToolTip="Salva os ajustes marcados num arquivo para aplicar igual em outros PCs.">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Exportar"/></StackPanel>
                                    </Button>
                                    <Button x:Name="BtnLimparSelecao" Style="{StaticResource BtnFantasma}" Padding="10,9">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE711;" Style="{StaticResource IconeBtn}" FontSize="11"/><TextBlock Text="Desmarcar"/></StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <Grid Grid.Row="2" Margin="36,6,36,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.35*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ListBox x:Name="ListaAjustes" Background="Transparent" Foreground="{DynamicResource Texto}" BorderThickness="0" Padding="0"
                                     ItemContainerStyle="{StaticResource ItemLista}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <Grid Margin="6,18,6,6">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource AcentoSuave}">
                                                        <TextBlock x:Name="Ic" Text="&#xE713;" Style="{StaticResource Icone}" FontSize="14" Foreground="{DynamicResource Acento}" HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/>
                                                        <TextBlock Text="{Binding ItemCount, StringFormat='  ·  {0}'}" Foreground="{DynamicResource TextoFraco}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Style="{StaticResource BtnLink}" Tag="{Binding Name}" Content="Marcar todos" VerticalAlignment="Center"/>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Name}" Value="Mouse e teclado"><Setter TargetName="Ic" Property="Text" Value="&#xE962;"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="Energia"><Setter TargetName="Ic" Property="Text" Value="&#xE945;"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="Jogos"><Setter TargetName="Ic" Property="Text" Value="&#xE7FC;"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="Visual e desempenho"><Setter TargetName="Ic" Property="Text" Value="&#xEC4A;"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="Barra de tarefas e Iniciar"><Setter TargetName="Ic" Property="Text" Value="&#xE8A9;"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="Explorador e produtividade"><Setter TargetName="Ic" Property="Text" Value="&#xE737;"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="Privacidade e anúncios"><Setter TargetName="Ic" Property="Text" Value="&#xE72E;"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="Sistema e atualizações"><Setter TargetName="Ic" Property="Text" Value="&#xE9F5;"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="Rede"><Setter TargetName="Ic" Property="Text" Value="&#xE968;"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="Limpeza"><Setter TargetName="Ic" Property="Text" Value="&#xE74D;"/></DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid x:Name="Linha" Background="Transparent">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <CheckBox Style="{StaticResource Caixa}" IsChecked="{Binding Selecionado, Mode=TwoWay}" IsEnabled="{Binding Habilitado}" VerticalAlignment="Center" Margin="2,0,14,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Resumo}" Foreground="{DynamicResource TextoSec}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,2,0">
                                                <TextBlock Text="&#xE72C;" Style="{StaticResource Icone}" FontSize="12" Foreground="{DynamicResource TextoFraco}" Margin="0,0,10,0"
                                                           Visibility="{Binding TemReinicio, Converter={StaticResource B2V}}" ToolTip="{Binding ReinicioTexto}"/>
                                                <Ellipse Style="{StaticResource PontoRisco}" Margin="0,0,10,0" ToolTip="{Binding RiscoDica}"/>
                                                <Border Style="{StaticResource PilulaEstado}">
                                                    <TextBlock Text="{Binding EstadoTexto}" FontSize="11.5" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Habilitado}" Value="False">
                                                <Setter TargetName="Linha" Property="Opacity" Value="0.45"/>
                                                <Setter TargetName="Linha" Property="ToolTip" Value="{Binding Motivo}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Painel de detalhes -->
                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" DataContext="{Binding SelectedItem, ElementName=ListaAjustes}" Margin="0,8,0,0">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Border Width="64" Height="64" CornerRadius="20" Background="{DynamicResource AcentoSuave}" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE946;" Style="{StaticResource Icone}" FontSize="28" Foreground="{DynamicResource Acento}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Clique em um ajuste" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" Margin="0,16,0,4"/>
                                        <TextBlock Text="Aqui aparece o que ele faz, para quem é indicado, o que muda no sistema e como desfazer." Foreground="{DynamicResource TextoSec}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280"/>
                                    </StackPanel>
                                    <ScrollViewer x:Name="RolagemDetalhe" VerticalScrollBarVisibility="Auto">
                                        <ScrollViewer.Style>
                                            <Style TargetType="ScrollViewer">
                                                <Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </ScrollViewer.Style>
                                        <StackPanel Margin="24,22,24,24">
                                            <TextBlock Text="{Binding Categoria}" Style="{StaticResource Rotulo}" Foreground="{DynamicResource Acento}"/>
                                            <TextBlock Text="{Binding Nome}" FontFamily="{DynamicResource FonteTitulo}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Resumo}" Style="{StaticResource CorpoSec}" Margin="0,6,0,14"/>
                                            <WrapPanel>
                                                <Border Style="{StaticResource PilulaRisco}" ToolTip="{Binding RiscoDica}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xEA18;" Style="{StaticResource Icone}" FontSize="12" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding RiscoTexto}" FontSize="12.5" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource Chip}" Padding="10,3">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icone}" FontSize="12" Margin="0,0,6,0" Foreground="{DynamicResource TextoSec}"/>
                                                        <TextBlock Text="{Binding ReinicioTexto}" FontSize="12.5" Foreground="{DynamicResource TextoSec}"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource PilulaEstado}" Padding="10,3" Margin="0,0,8,8">
                                                    <TextBlock Text="{Binding EstadoTexto}" FontSize="12.5" FontWeight="SemiBold"/>
                                                </Border>
                                            </WrapPanel>
                                            <TextBlock Text="{Binding EstadoDetalhe}" Foreground="{DynamicResource TextoSec}" FontStyle="Italic" FontSize="13" TextWrapping="Wrap"
                                                       Visibility="{Binding TemEstadoDetalhe, Converter={StaticResource B2V}}" Margin="0,0,0,6"/>

                                            <TextBlock Text="O que faz" FontWeight="SemiBold" Margin="0,14,0,4"/>
                                            <TextBlock Text="{Binding Detalhe}" Style="{StaticResource Corpo}"/>

                                            <StackPanel Visibility="{Binding TemIndicado, Converter={StaticResource B2V}}">
                                                <TextBlock Text="Indicado para" FontWeight="SemiBold" Margin="0,16,0,4"/>
                                                <TextBlock Text="{Binding Indicado}" Style="{StaticResource Corpo}"/>
                                            </StackPanel>

                                            <Border Background="{DynamicResource AvisoSuave}" CornerRadius="10" Padding="14,10" Margin="0,16,0,0"
                                                    Visibility="{Binding TemAtencao, Converter={StaticResource B2V}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icone}" Foreground="{DynamicResource Aviso}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Atencao}" Style="{StaticResource Corpo}" Foreground="{DynamicResource Aviso}"/>
                                                </Grid>
                                            </Border>

                                            <StackPanel Visibility="{Binding TemGlossario, Converter={StaticResource B2V}}">
                                                <TextBlock Text="Palavras deste ajuste" FontWeight="SemiBold" Margin="0,18,0,6"/>
                                                <Border Background="{DynamicResource InfoSuave}" CornerRadius="10" Padding="14,10">
                                                    <TextBlock Text="{Binding Glossario}" Style="{StaticResource Corpo}" FontSize="13"/>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="No seu PC: agora → depois de aplicar" FontWeight="SemiBold" Margin="0,18,0,6"/>
                                            <TextBox Text="{Binding Previa, Mode=OneWay}" Style="{StaticResource CampoCodigo}" MaxHeight="170"/>
                                            <TextBlock Text="&quot;→&quot; = vai mudar · &quot;=&quot; = já está assim" FontSize="11.5" Foreground="{DynamicResource TextoFraco}" Margin="2,4,0,0"/>

                                            <StackPanel x:Name="PainelTecnico">
                                                <TextBlock Text="O que muda no sistema (técnico)" FontWeight="SemiBold" Margin="0,18,0,6"/>
                                                <TextBox Text="{Binding Tecnico, Mode=OneWay}" Style="{StaticResource CampoCodigo}" MaxHeight="190"/>
                                            </StackPanel>

                                            <TextBlock Text="Como desfazer" FontWeight="SemiBold" Margin="0,16,0,4"/>
                                            <TextBlock Text="{Binding ComoDesfazer}" Style="{StaticResource Corpo}"/>

                                            <Button x:Name="BtnDesfazerItem" Style="{StaticResource BtnPerigo}" HorizontalAlignment="Left" Margin="0,16,0,0" Tag="{Binding Id}"
                                                    Visibility="{Binding PodeDesfazer, Converter={StaticResource B2V}}">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7AD;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Desfazer este ajuste"/></StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="36,14,36,24" Padding="20,14">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource AcentoSuave}">
                                    <TextBlock x:Name="TxtSelecaoNumero" Text="0" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource Acento}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <TextBlock x:Name="TxtSelecao" Text="Nenhum ajuste selecionado" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtSelecaoSub" Text="Escolha um perfil acima ou marque os itens da lista." FontSize="12.5" Foreground="{DynamicResource TextoSec}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button x:Name="BtnSimular" Style="{StaticResource BtnSecundario}" Margin="0,0,10,0" IsEnabled="False"
                                            ToolTip="Mostra o que mudaria em cada item, sem alterar nada.">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7B3;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Simular"/></StackPanel>
                                    </Button>
                                    <Button x:Name="BtnAplicar" Style="{StaticResource BtnPrimario}" IsEnabled="False">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Aplicar selecionados"/></StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ============ FERRAMENTAS ============ -->
                    <Grid x:Name="PagFerramentas" Visibility="Collapsed">
                        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Margin="36,30,36,0">
                            <TextBlock Style="{StaticResource Titulo}" Text="Ferramentas"/>
                            <TextBlock Style="{StaticResource Subtitulo}" Text="Utilitários do dia a dia: rede, inicialização, equipamentos, reparo e programas."/>
                        </StackPanel>
                        <WrapPanel Grid.Row="1" Margin="36,20,36,4">
                            <RadioButton x:Name="RbFerRede" Style="{StaticResource Pill}" GroupName="fer" IsChecked="True"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Rede e DNS"/></StackPanel></RadioButton>
                            <RadioButton x:Name="RbFerInicio" Style="{StaticResource Pill}" GroupName="fer"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7E8;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Inicialização"/></StackPanel></RadioButton>
                            <RadioButton x:Name="RbFerServidor" Style="{StaticResource Pill}" GroupName="fer"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE968;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Testar servidor"/></StackPanel></RadioButton>
                            <RadioButton x:Name="RbFerSerial" Style="{StaticResource Pill}" GroupName="fer"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE88E;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Drivers e portas COM"/></StackPanel></RadioButton>
                            <RadioButton x:Name="RbFerReparo" Style="{StaticResource Pill}" GroupName="fer"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE90F;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Reparar Windows"/></StackPanel></RadioButton>
                            <RadioButton x:Name="RbFerProgramas" Style="{StaticResource Pill}" GroupName="fer"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Programas"/></StackPanel></RadioButton>
                            <RadioButton x:Name="RbFerRelatorio" Style="{StaticResource Pill}" GroupName="fer"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Relatório do PC"/></StackPanel></RadioButton>
                            <RadioButton x:Name="RbFerMonitor" Style="{StaticResource Pill}" GroupName="fer"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Monitor de conexão"/></StackPanel></RadioButton>
                            <RadioButton x:Name="RbFerManut" Style="{StaticResource Pill}" GroupName="fer"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Manutenção automática"/></StackPanel></RadioButton>
                            <RadioButton x:Name="RbFerEspaco" Style="{StaticResource Pill}" GroupName="fer"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xEDA2;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Espaço em disco"/></StackPanel></RadioButton>
                            <RadioButton x:Name="RbFerProtecao" Style="{StaticResource Pill}" GroupName="fer"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72E;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Proteção (antivírus)"/></StackPanel></RadioButton>
                            <RadioButton x:Name="RbFerOffice" Style="{StaticResource Pill}" GroupName="fer"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Desinstalar Office"/></StackPanel></RadioButton>
                            <RadioButton x:Name="RbFerAtalhos" Style="{StaticResource Pill}" GroupName="fer"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Atalhos do Windows"/></StackPanel></RadioButton>
                        </WrapPanel>

                        <Grid Grid.Row="2" Margin="36,8,36,24">
                            <!-- Rede -->
                            <ScrollViewer x:Name="FerRede" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="Conexões ativas" FontWeight="SemiBold" FontSize="15"/>
                                                <Button x:Name="BtnRedeAtualizar" Style="{StaticResource BtnFantasma}" HorizontalAlignment="Right" Padding="10,5">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource IconeBtn}" FontSize="12"/><TextBlock Text="Atualizar"/></StackPanel>
                                                </Button>
                                            </Grid>
                                            <ItemsControl x:Name="ListaAdaptadores" Margin="0,10,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,6">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <Border Style="{StaticResource IconeCirculo}" Width="38" Height="38"><TextBlock Text="{Binding Icone}" Style="{StaticResource Icone}" FontSize="16" Foreground="{DynamicResource Acento}" HorizontalAlignment="Center"/></Border>
                                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding Texto}" FontSize="12.5" Foreground="{DynamicResource TextoSec}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock x:Name="TxtRedeVazia" Text="Carregando conexões..." Foreground="{DynamicResource TextoSec}" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="Servidor de DNS" FontWeight="SemiBold" FontSize="15"/>
                                            <TextBlock Style="{StaticResource CorpoSec}" Margin="0,4,0,14" Text="O DNS transforma nomes (google.com) em endereços. Um DNS rápido faz os sites começarem a abrir mais cedo. Teste antes de escolher: o mais rápido muda de lugar para lugar."/>
                                            <UniformGrid Columns="4" Margin="0,0,-10,0">
                                                <RadioButton x:Name="RbDnsCloudflare" Style="{StaticResource CartaoEscolha}" GroupName="dns" Tag="cloudflare">
                                                    <StackPanel><TextBlock Text="Cloudflare" FontWeight="SemiBold"/><TextBlock Text="1.1.1.1" FontSize="12" Foreground="{DynamicResource TextoSec}"/><TextBlock Text="Geralmente o mais rápido." FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextoSec}" Margin="0,6,0,0"/><TextBlock x:Name="TxtDnsMsCloudflare" FontWeight="SemiBold" Foreground="{DynamicResource Acento}" Margin="0,6,0,0"/></StackPanel>
                                                </RadioButton>
                                                <RadioButton x:Name="RbDnsGoogle" Style="{StaticResource CartaoEscolha}" GroupName="dns" Tag="google">
                                                    <StackPanel><TextBlock Text="Google" FontWeight="SemiBold"/><TextBlock Text="8.8.8.8" FontSize="12" Foreground="{DynamicResource TextoSec}"/><TextBlock Text="Muito estável e conhecido." FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextoSec}" Margin="0,6,0,0"/><TextBlock x:Name="TxtDnsMsGoogle" FontWeight="SemiBold" Foreground="{DynamicResource Acento}" Margin="0,6,0,0"/></StackPanel>
                                                </RadioButton>
                                                <RadioButton x:Name="RbDnsQuad9" Style="{StaticResource CartaoEscolha}" GroupName="dns" Tag="quad9">
                                                    <StackPanel><TextBlock Text="Quad9" FontWeight="SemiBold"/><TextBlock Text="9.9.9.9" FontSize="12" Foreground="{DynamicResource TextoSec}"/><TextBlock Text="Bloqueia sites de golpe conhecidos." FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextoSec}" Margin="0,6,0,0"/><TextBlock x:Name="TxtDnsMsQuad9" FontWeight="SemiBold" Foreground="{DynamicResource Acento}" Margin="0,6,0,0"/></StackPanel>
                                                </RadioButton>
                                                <RadioButton x:Name="RbDnsAuto" Style="{StaticResource CartaoEscolha}" GroupName="dns" Tag="auto">
                                                    <StackPanel><TextBlock Text="Automático" FontWeight="SemiBold"/><TextBlock Text="do roteador" FontSize="12" Foreground="{DynamicResource TextoSec}"/><TextBlock Text="Use em empresa com DNS interno." FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextoSec}" Margin="0,6,0,0"/><TextBlock x:Name="TxtDnsMsAuto" FontWeight="SemiBold" Foreground="{DynamicResource Acento}" Margin="0,6,0,0"/></StackPanel>
                                                </RadioButton>
                                            </UniformGrid>
                                            <WrapPanel Margin="0,6,0,0">
                                                <Button x:Name="BtnDnsTestar" Style="{StaticResource BtnSecundario}" Margin="0,0,10,0">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEC4A;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Testar velocidade"/></StackPanel>
                                                </Button>
                                                <Button x:Name="BtnDnsAplicar" Style="{StaticResource BtnPrimario}" Margin="0,0,10,0" IsEnabled="False">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Usar o DNS escolhido"/></StackPanel>
                                                </Button>
                                                <Button x:Name="BtnDnsRestaurar" Style="{StaticResource BtnFantasma}">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7AD;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Voltar ao DNS original"/></StackPanel>
                                                </Button>
                                            </WrapPanel>
                                            <ItemsControl x:Name="ListaDnsTeste" Margin="0,14,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,4">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Titulo}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <Border Grid.Column="1" Height="10" CornerRadius="5" Background="{DynamicResource Superficie2}">
                                                                <Border HorizontalAlignment="Left" CornerRadius="5" Background="{DynamicResource AcentoGrad}" Width="{Binding Valor}"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="2" Text="{Binding Texto}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="Consertar a internet" FontWeight="SemiBold" FontSize="15"/>
                                            <TextBlock Style="{StaticResource CorpoSec}" Margin="0,4,0,14" Text="Site que não abre só neste PC? Comece limpando o cache. Se nada resolver, o reset completo reconstrói as configurações de rede do Windows (exige reiniciar; Wi-Fi salvo e IP fixo continuam)."/>
                                            <WrapPanel>
                                                <Button x:Name="BtnLimparDns" Style="{StaticResource BtnSecundario}" Margin="0,0,10,0">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Limpar cache de DNS"/></StackPanel>
                                                </Button>
                                                <Button x:Name="BtnResetRede" Style="{StaticResource BtnPerigo}">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE895;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Reset completo da rede"/></StackPanel>
                                                </Button>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Inicialização -->
                            <Grid x:Name="FerInicio" Visibility="Collapsed">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="18,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="TxtInicioResumo" Text="Carregando..." FontWeight="SemiBold" FontSize="15"/>
                                            <TextBlock Style="{StaticResource CorpoSec}" FontSize="13" Margin="0,4,0,0" Text="Desligue o que você não precisa logo ao ligar o PC. Mantenha antivírus e drivers (áudio, touchpad, vídeo). Dá para religar a qualquer momento, aqui ou no Gerenciador de Tarefas."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                            <Button x:Name="BtnInicioAtualizar" Style="{StaticResource BtnFantasma}" Padding="10,6"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource IconeBtn}" FontSize="12"/><TextBlock Text="Atualizar"/></StackPanel></Button>
                                            <Button x:Name="BtnInicioGerTarefas" Style="{StaticResource BtnSecundario}" Margin="8,0,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9F5;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Gerenciador de Tarefas"/></StackPanel></Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ListaInicio">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <CheckBox Style="{StaticResource Interruptor}" IsChecked="{Binding Ativo, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Comando}" FontSize="12" Foreground="{DynamicResource TextoSec}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Comando}"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="2" Style="{StaticResource Chip}" Margin="12,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Escopo}" FontSize="11.5" Foreground="{DynamicResource TextoSec}"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>

                            <!-- Testar servidor -->
                            <ScrollViewer x:Name="FerServidor" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="Esse servidor responde?" FontWeight="SemiBold" FontSize="15"/>
                                            <TextBlock Style="{StaticResource CorpoSec}" Margin="0,4,0,14" Text="Testa se um endereço aceita conexão numa porta TCP. Serve para plataformas de rastreamento, APIs, bancos de dados, câmeras, rastreadores e servidores de arquivos."/>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="120"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBox x:Name="TxtServidorHost" Style="{StaticResource Campo}" Tag="Endereço (ex.: api.empresa.com.br ou 192.168.0.10)"/>
                                                <TextBox x:Name="TxtServidorPorta" Grid.Column="2" Style="{StaticResource Campo}" Tag="Porta"/>
                                                <Button x:Name="BtnServidorTestar" Grid.Column="4" Style="{StaticResource BtnPrimario}">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Testar"/></StackPanel>
                                                </Button>
                                            </Grid>
                                            <WrapPanel x:Name="PainelPortas" Margin="0,12,0,0">
                                                <TextBlock Text="Portas comuns:" Foreground="{DynamicResource TextoSec}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <Button Style="{StaticResource BtnLink}" Tag="443" Content="HTTPS 443"/>
                                                <Button Style="{StaticResource BtnLink}" Tag="80" Content="HTTP 80"/>
                                                <Button Style="{StaticResource BtnLink}" Tag="22" Content="SSH 22"/>
                                                <Button Style="{StaticResource BtnLink}" Tag="3389" Content="Área remota 3389"/>
                                                <Button Style="{StaticResource BtnLink}" Tag="1883" Content="MQTT 1883"/>
                                                <Button Style="{StaticResource BtnLink}" Tag="8883" Content="MQTT TLS 8883"/>
                                                <Button Style="{StaticResource BtnLink}" Tag="3306" Content="MySQL 3306"/>
                                                <Button Style="{StaticResource BtnLink}" Tag="5432" Content="PostgreSQL 5432"/>
                                                <Button Style="{StaticResource BtnLink}" Tag="1433" Content="SQL Server 1433"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="PainelServidorResultado" Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border x:Name="CirculoServidor" Width="56" Height="56" CornerRadius="28" Background="{DynamicResource OkSuave}">
                                                <TextBlock x:Name="IcoServidor" Text="&#xE73E;" Style="{StaticResource Icone}" FontSize="24" Foreground="{DynamicResource Ok}" HorizontalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtServidorTitulo" FontSize="17" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="TxtServidorDetalhe" Style="{StaticResource CorpoSec}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="TxtServidorHistTitulo" Text="Testes desta sessão" FontWeight="SemiBold" Margin="0,4,0,8" Visibility="Collapsed"/>
                                    <ItemsControl x:Name="ListaServidorHist">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource IconeNivel}" Margin="0,0,12,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Titulo}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Texto}" Foreground="{DynamicResource TextoSec}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Texto}"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding Extra}" Foreground="{DynamicResource TextoFraco}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource CorpoSec}" FontSize="12.5" Margin="0,10,0,0" Text="Sobre UDP: UDP não tem 'conexão', então não dá para testar do mesmo jeito. É preciso um programa no servidor que responda às mensagens."/>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Drivers e COM -->
                            <ScrollViewer x:Name="FerSerial" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="Drivers USB-serial instalados" FontWeight="SemiBold" FontSize="15"/>
                                                <Button x:Name="BtnSerialAtualizar" Style="{StaticResource BtnFantasma}" HorizontalAlignment="Right" Padding="10,5">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource IconeBtn}" FontSize="12"/><TextBlock Text="Verificar de novo"/></StackPanel>
                                                </Button>
                                            </Grid>
                                            <TextBlock Style="{StaticResource CorpoSec}" FontSize="13" Margin="0,4,0,10" Text="Adaptadores e placas (rastreadores, Arduino, ESP32, módulos GPS) usam um destes chips. Dispositivos USB CDC usam o driver nativo do Windows."/>
                                            <ItemsControl x:Name="ListaChips">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,5">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <TextBlock Style="{StaticResource IconeNivel}" Margin="0,0,12,0"/>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding Texto}" FontSize="12.5" Foreground="{DynamicResource TextoSec}"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="2" Style="{StaticResource BtnLink}" Tag="{Binding Tag}" Content="Site oficial do driver"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <WrapPanel Margin="0,12,0,0">
                                                <Button x:Name="BtnSerialInstalar" Style="{StaticResource BtnPrimario}" Margin="0,0,10,0">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Instalar driver de uma pasta..."/></StackPanel>
                                                </Button>
                                                <Button x:Name="BtnSerialGerDisp" Style="{StaticResource BtnSecundario}">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE772;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Gerenciador de Dispositivos"/></StackPanel>
                                                </Button>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="Portas COM conectadas agora" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                                            <TextBlock x:Name="TxtPortasVazio" Text="Nenhuma porta COM. Conecte o equipamento e clique em Verificar de novo." Foreground="{DynamicResource TextoSec}" TextWrapping="Wrap"/>
                                            <ItemsControl x:Name="ListaPortas">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,5">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <TextBlock Style="{StaticResource IconeNivel}" Margin="0,0,12,0"/>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding Texto}" FontSize="12.5" Foreground="{DynamicResource TextoSec}" Visibility="{Binding TemTexto, Converter={StaticResource B2V}}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="Dispositivos USB com problema" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                                            <TextBlock x:Name="TxtUsbVazio" Text="Nenhum. Todos os dispositivos USB conectados têm driver." Foreground="{DynamicResource TextoSec}"/>
                                            <ItemsControl x:Name="ListaUsbErro">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,5">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <TextBlock Style="{StaticResource IconeNivel}" Margin="0,0,12,0" VerticalAlignment="Top"/>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding Texto}" FontSize="12.5" Foreground="{DynamicResource TextoSec}" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Extra}" FontSize="11.5" Foreground="{DynamicResource TextoFraco}" FontFamily="{DynamicResource FonteCodigo}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Reparar Windows -->
                            <Grid x:Name="FerReparo" Visibility="Collapsed">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Border Style="{StaticResource IconeCirculo}"><TextBlock Text="&#xE9D9;" Style="{StaticResource Icone}" FontSize="18" Foreground="{DynamicResource Acento}" HorizontalAlignment="Center"/></Border>
                                            <TextBlock Text="1. Reparar a imagem do Windows (DISM)" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,4"/>
                                            <TextBlock Style="{StaticResource CorpoSec}" FontSize="13" Text="Baixa do Windows Update as peças danificadas da cópia de segurança que o próprio Windows usa para se consertar. Precisa de internet. De 10 a 30 minutos."/>
                                            <Button x:Name="BtnDism" Style="{StaticResource BtnSecundario}" HorizontalAlignment="Left" Margin="0,14,0,0">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Iniciar DISM"/></StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Border Style="{StaticResource IconeCirculo}"><TextBlock Text="&#xE90F;" Style="{StaticResource Icone}" FontSize="18" Foreground="{DynamicResource Acento}" HorizontalAlignment="Center"/></Border>
                                            <TextBlock Text="2. Verificar arquivos do sistema (SFC)" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,4"/>
                                            <TextBlock Style="{StaticResource CorpoSec}" FontSize="13" Text="Procura arquivos do Windows corrompidos e troca pela cópia boa. Resolve travamentos estranhos e telas de erro. De 5 a 15 minutos."/>
                                            <Button x:Name="BtnSfc" Style="{StaticResource BtnSecundario}" HorizontalAlignment="Left" Margin="0,14,0,0">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Iniciar SFC"/></StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border Grid.Row="1" Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Grid>
                                            <TextBlock x:Name="TxtReparoStatus" Text="Ordem recomendada quando o Windows está estranho: 1) DISM, 2) SFC, 3) reiniciar." FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,80,0"/>
                                            <TextBlock x:Name="TxtReparoPct" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{DynamicResource Acento}"/>
                                        </Grid>
                                        <ProgressBar x:Name="BarraReparo" Grid.Row="1" Style="{StaticResource Barra}" Margin="0,12,0,12" Maximum="100"/>
                                        <TextBox x:Name="LogReparo" Grid.Row="2" Style="{StaticResource CampoCodigo}" MinHeight="120"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Programas (winget) -->
                            <Grid x:Name="FerProgramas" Visibility="Collapsed">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Instalar programas de uma vez" FontWeight="SemiBold" FontSize="15"/>
                                            <TextBlock x:Name="TxtWingetFonte" Style="{StaticResource CorpoSec}" FontSize="13" Margin="0,4,0,12"/>
                                        </StackPanel>
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl x:Name="ListaWinget">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.GroupStyle>
                                                    <GroupStyle>
                                                        <GroupStyle.HeaderTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TextoSec}" Margin="2,14,0,8"/>
                                                            </DataTemplate>
                                                        </GroupStyle.HeaderTemplate>
                                                        <GroupStyle.Panel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></GroupStyle.Panel>
                                                    </GroupStyle>
                                                </ItemsControl.GroupStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="232" Background="{DynamicResource Superficie2}" CornerRadius="10" Padding="12,9" Margin="0,0,8,8" ToolTip="{Binding Tag}">
                                                            <CheckBox Style="{StaticResource Caixa}" IsChecked="{Binding Marcado, Mode=TwoWay}">
                                                                <TextBlock Text="{Binding Titulo}" TextTrimming="CharacterEllipsis"/>
                                                            </CheckBox>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                                            <Button x:Name="BtnWingetInstalar" Style="{StaticResource BtnPrimario}" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Instalar selecionados"/></StackPanel>
                                            </Button>
                                            <Button x:Name="BtnWingetAtualizar" Style="{StaticResource BtnSecundario}" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE895;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Atualizar todos os programas"/></StackPanel>
                                            </Button>
                                            <Button x:Name="BtnWingetExportar" Style="{StaticResource BtnFantasma}" Margin="0,0,6,0" ToolTip="Salva a lista de programas deste PC para reinstalar tudo depois de formatar.">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Exportar lista deste PC"/></StackPanel>
                                            </Button>
                                            <Button x:Name="BtnWingetImportar" Style="{StaticResource BtnFantasma}">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E5;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Importar lista..."/></StackPanel>
                                            </Button>
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtWingetStatus" Text="Pronto." FontWeight="SemiBold"/>
                                        <ProgressBar x:Name="BarraWinget" Style="{StaticResource Barra}" Margin="0,10,0,10" Maximum="100"/>
                                        <TextBox x:Name="LogWinget" Style="{StaticResource CampoCodigo}" Height="150"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Relatório -->
                            <ScrollViewer x:Name="FerRelatorio" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                <Border Style="{StaticResource Card}" Padding="28">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="72" Height="72" CornerRadius="20" Background="{DynamicResource AcentoGrad}" VerticalAlignment="Top">
                                            <TextBlock Text="&#xE9D9;" Style="{StaticResource Icone}" FontSize="32" Foreground="White" HorizontalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="22,0,0,0">
                                            <TextBlock Text="Relatório completo do PC" FontFamily="{DynamicResource FonteTitulo}" FontSize="20" FontWeight="SemiBold"/>
                                            <TextBlock Style="{StaticResource CorpoSec}" Margin="0,6,0,0" Text="Gera uma página com tudo sobre o computador: processador, memória (pente por pente), vídeo, saúde, temperatura e desgaste dos discos, partições, pontos de atenção e recomendações para o tipo do seu PC (Low, Mid ou High-end)."/>
                                            <TextBlock Style="{StaticResource CorpoSec}" Margin="0,10,0,0" Text="Dica: gere um antes e outro depois de otimizar para comparar. Os relatórios ficam salvos na pasta de dados."/>
                                            <WrapPanel Margin="0,18,0,0">
                                                <Button x:Name="BtnRelatorioGerar" Style="{StaticResource BtnPrimario}" Margin="0,0,10,0">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Gerar e abrir relatório"/></StackPanel>
                                                </Button>
                                                <Button x:Name="BtnRelatorioPasta" Style="{StaticResource BtnFantasma}">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Abrir pasta dos relatórios"/></StackPanel>
                                                </Button>
                                            </WrapPanel>
                                            <TextBlock x:Name="TxtRelatorioStatus" Foreground="{DynamicResource TextoSec}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </ScrollViewer>

                            <!-- Monitor de conexão -->
                            <ScrollViewer x:Name="FerMonitor" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="A internet está caindo? Descubra onde" FontWeight="SemiBold" FontSize="15"/>
                                            <TextBlock Style="{StaticResource CorpoSec}" FontSize="13" Margin="0,4,0,12" Text="Mede a cada segundo o tempo de resposta do seu roteador e de um servidor na internet, lado a lado. Se o problema aparece já no roteador, é Wi-Fi, cabo ou placa de rede. Se só a internet falha, é com o provedor."/>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Internet:" VerticalAlignment="Center" Foreground="{DynamicResource TextoSec}" Margin="0,0,10,0"/>
                                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <RadioButton x:Name="RbMonCloudflare" Style="{StaticResource Pill}" GroupName="mon" Tag="1.1.1.1" Content="Cloudflare 1.1.1.1" IsChecked="True" Margin="0,0,8,0"/>
                                                    <RadioButton x:Name="RbMonGoogle" Style="{StaticResource Pill}" GroupName="mon" Tag="8.8.8.8" Content="Google 8.8.8.8" Margin="0,0,8,0"/>
                                                    <RadioButton x:Name="RbMonOutro" Style="{StaticResource Pill}" GroupName="mon" Tag="" Content="Meu servidor" Margin="0,0,8,0"/>
                                                    <TextBox x:Name="TxtMonOutro" Style="{StaticResource Campo}" Width="220" Tag="ex.: api.empresa.com.br" Padding="10,6" Visibility="Collapsed"/>
                                                </WrapPanel>
                                                <Button x:Name="BtnMonitor" Grid.Column="2" Style="{StaticResource BtnPrimario}">
                                                    <StackPanel Orientation="Horizontal"><TextBlock x:Name="IcoMonitor" Text="&#xE768;" Style="{StaticResource IconeBtn}"/><TextBlock x:Name="TxtBtnMonitor" Text="Começar"/></StackPanel>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource Card}" Padding="18,14">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Rectangle Width="16" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Serie1}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock x:Name="TxtMonRoteadorNome" Text="Roteador" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <TextBlock x:Name="TxtMonRoteadorAtual" Text="– ms" FontFamily="{DynamicResource FonteTitulo}" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                                <TextBlock x:Name="TxtMonRoteadorStats" Text="média – · perda – · variação –" Foreground="{DynamicResource TextoSec}" FontSize="12.5"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,14">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Rectangle Width="16" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Serie2}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock x:Name="TxtMonInternetNome" Text="Internet" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <TextBlock x:Name="TxtMonInternetAtual" Text="– ms" FontFamily="{DynamicResource FonteTitulo}" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                                <TextBlock x:Name="TxtMonInternetStats" Text="média – · perda – · variação –" Foreground="{DynamicResource TextoSec}" FontSize="12.5"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="Tempo de resposta (ms) - últimos 60 segundos" FontWeight="SemiBold"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Rectangle Width="14" Height="3" Fill="{DynamicResource Serie1}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Roteador" FontSize="12.5" Foreground="{DynamicResource TextoSec}" Margin="0,0,14,0"/>
                                                    <Rectangle Width="14" Height="3" Fill="{DynamicResource Serie2}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Internet" FontSize="12.5" Foreground="{DynamicResource TextoSec}" Margin="0,0,14,0"/>
                                                    <TextBlock Text="&#xE711;" Style="{StaticResource Icone}" FontSize="10" Foreground="{DynamicResource Erro}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="sem resposta" FontSize="12.5" Foreground="{DynamicResource TextoSec}"/>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Height="190" Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Canvas x:Name="EixoMonitor"/>
                                                <Canvas x:Name="GraficoMonitor" Grid.Column="1" Background="Transparent"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="CardMonDiag" Background="{DynamicResource InfoSuave}" CornerRadius="12" Padding="16,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="IcoMonDiag" Text="&#xE946;" Style="{StaticResource Icone}" FontSize="16" Foreground="{DynamicResource Info}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock x:Name="TxtMonDiagTitulo" Text="Diagnóstico" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="TxtMonDiag" Style="{StaticResource Corpo}" FontSize="13" Text="Clique em Começar e deixe rodar pelo menos 30 segundos (de preferência enquanto o problema acontece)."/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Manutenção automática -->
                            <ScrollViewer x:Name="FerManut" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,18">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border x:Name="CirculoManut" Width="52" Height="52" CornerRadius="14" Background="{DynamicResource Superficie2}">
                                                <TextBlock x:Name="IcoManut" Text="&#xE81C;" Style="{StaticResource Icone}" FontSize="22" Foreground="{DynamicResource TextoSec}" HorizontalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtManutTitulo" Text="Manutenção automática desligada" FontFamily="{DynamicResource FonteTitulo}" FontSize="20" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="TxtManutDetalhe" Foreground="{DynamicResource TextoSec}" Margin="0,2,0,0" TextWrapping="Wrap" Text="Limpa o PC e verifica a saúde sozinho, no dia e hora que você escolher."/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Text="Quando" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
                                                <Border Background="{DynamicResource Superficie2}" CornerRadius="10" Padding="3" HorizontalAlignment="Left">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="RbManutSemanal" Style="{StaticResource Segmento}" GroupName="manfreq" Content="Toda semana" IsChecked="True"/>
                                                        <RadioButton x:Name="RbManutDiaria" Style="{StaticResource Segmento}" GroupName="manfreq" Content="Todo dia"/>
                                                    </StackPanel>
                                                </Border>
                                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                    <StackPanel x:Name="PainelManutDia" Margin="0,0,16,0">
                                                        <TextBlock Style="{StaticResource Rotulo}" Text="DIA"/>
                                                        <ComboBox x:Name="CbManutDia" Width="150" SelectedIndex="0">
                                                            <ComboBoxItem Content="Domingo" Tag="Sunday"/>
                                                            <ComboBoxItem Content="Segunda-feira" Tag="Monday"/>
                                                            <ComboBoxItem Content="Terça-feira" Tag="Tuesday"/>
                                                            <ComboBoxItem Content="Quarta-feira" Tag="Wednesday"/>
                                                            <ComboBoxItem Content="Quinta-feira" Tag="Thursday"/>
                                                            <ComboBoxItem Content="Sexta-feira" Tag="Friday"/>
                                                            <ComboBoxItem Content="Sábado" Tag="Saturday"/>
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource Rotulo}" Text="HORA"/>
                                                        <ComboBox x:Name="CbManutHora" Width="100"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource CorpoSec}" FontSize="12.5" Margin="0,12,0,0" Text="Roda escondida, sem atrapalhar, e só com você logado. Se o PC estiver desligado no horário, roda assim que ele ligar."/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Text="O que fazer" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
                                                <CheckBox x:Name="ChkManutTemp" Style="{StaticResource Caixa}" Content="Apagar arquivos temporários" IsChecked="True" Margin="0,4"/>
                                                <CheckBox x:Name="ChkManutDns" Style="{StaticResource Caixa}" Content="Limpar cache de DNS" IsChecked="True" Margin="0,4"/>
                                                <CheckBox x:Name="ChkManutLixeira" Style="{StaticResource Caixa}" Content="Esvaziar a Lixeira (apaga para sempre)" Margin="0,4"/>
                                                <CheckBox x:Name="ChkManutVerificar" Style="{StaticResource Caixa}" Content="Verificar o PC e guardar a nota (gráfico de evolução)" IsChecked="True" Margin="0,4"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <WrapPanel Margin="0,14,0,14">
                                        <Button x:Name="BtnManutAtivar" Style="{StaticResource BtnPrimario}" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" Style="{StaticResource IconeBtn}"/><TextBlock x:Name="TxtBtnManutAtivar" Text="Ligar manutenção"/></StackPanel>
                                        </Button>
                                        <Button x:Name="BtnManutAgora" Style="{StaticResource BtnSecundario}" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Rodar agora"/></StackPanel>
                                        </Button>
                                        <Button x:Name="BtnManutDesligar" Style="{StaticResource BtnFantasma}" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE711;" Style="{StaticResource IconeBtn}" FontSize="11"/><TextBlock Text="Desligar"/></StackPanel>
                                        </Button>
                                    </WrapPanel>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="Última execução" FontWeight="SemiBold" FontSize="15"/>
                                            <TextBlock x:Name="TxtManutUltima" Style="{StaticResource CorpoSec}" FontSize="13" Margin="0,4,0,8" Text="Ainda não rodou."/>
                                            <ItemsControl x:Name="ListaManutUltima">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <TextBlock Style="{StaticResource IconeNivel}" FontSize="13" Margin="0,2,10,0" VerticalAlignment="Top"/>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Titulo}"/>
                                                                <TextBlock Text="{Binding Texto}" FontSize="12" Foreground="{DynamicResource TextoSec}" TextWrapping="Wrap" Visibility="{Binding TemTexto, Converter={StaticResource B2V}}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                            <!-- Espaço em disco -->
                            <ScrollViewer x:Name="FerEspaco" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,18">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Border Width="52" Height="52" CornerRadius="14" Background="{DynamicResource AcentoSuave}"><TextBlock Text="&#xEDA2;" Style="{StaticResource Icone}" FontSize="22" Foreground="{DynamicResource Acento}" HorizontalAlignment="Center"/></Border>
                                            <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtEspacoDisco" Text="Disco do sistema" FontFamily="{DynamicResource FonteTitulo}" FontSize="20" FontWeight="SemiBold"/>
                                                <ProgressBar x:Name="BarraEspacoDisco" Style="{StaticResource Barra}" Maximum="100" Margin="0,10,0,6"/>
                                                <TextBlock x:Name="TxtEspacoDiscoSub" Foreground="{DynamicResource TextoSec}" FontSize="13"/>
                                            </StackPanel>
                                            <Button x:Name="BtnEspacoAnalisar" Grid.Column="2" Style="{StaticResource BtnSecundario}" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Analisar de novo"/></StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="Onde está o espaço" FontWeight="SemiBold" FontSize="15"/>
                                            <TextBlock x:Name="TxtEspacoStatus" Style="{StaticResource CorpoSec}" FontSize="13" Margin="0,4,0,10" Text="Medindo as pastas que mais costumam encher o disco..."/>
                                            <ItemsControl x:Name="ListaEspaco">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,7">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center" ToolTip="{Binding Texto}">
                                                                <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Texto}" FontSize="11.5" Foreground="{DynamicResource TextoFraco}" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <ProgressBar Grid.Column="1" Style="{StaticResource Barra}" Maximum="1" Value="{Binding Valor, Mode=OneWay}" VerticalAlignment="Center" Margin="12,0"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Extra}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="3" Style="{StaticResource BtnLink}" Tag="{Binding Tag}" Content="{Binding Icone}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="Maiores arquivos da sua pasta" FontWeight="SemiBold" FontSize="15"/>
                                                    <TextBlock x:Name="TxtGrandesStatus" Style="{StaticResource CorpoSec}" FontSize="13" Margin="0,4,0,0" Text="Procura arquivos acima de 300 MB na sua pasta de usuário. Só mostra; nada é apagado."/>
                                                </StackPanel>
                                                <Button x:Name="BtnGrandesProcurar" Style="{StaticResource BtnSecundario}" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Procurar"/></StackPanel>
                                                </Button>
                                            </Grid>
                                            <ItemsControl x:Name="ListaGrandes" Margin="0,10,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,6">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="&#xE8A5;" Style="{StaticResource Icone}" Foreground="{DynamicResource Acento}" Margin="0,2,12,0" VerticalAlignment="Top"/>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Tag}" FontSize="11.5" Foreground="{DynamicResource TextoFraco}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Tag}"/>
                                                                <TextBlock Text="{Binding Texto}" FontSize="12" Foreground="{DynamicResource Info}" TextWrapping="Wrap" Visibility="{Binding TemTexto, Converter={StaticResource B2V}}"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{Binding Extra}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                                            <Button Grid.Column="3" Style="{StaticResource BtnLink}" Tag="{Binding Tag}" Content="Mostrar na pasta" Margin="10,0,0,0" VerticalAlignment="Top"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                            <!-- Proteção (antivírus) -->
                            <ScrollViewer x:Name="FerProtecao" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border x:Name="CardProtEstado" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,18">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Border x:Name="CirculoProt" Width="56" Height="56" CornerRadius="16" Background="{DynamicResource OkSuave}">
                                                <TextBlock x:Name="IcoProt" Text="&#xE72E;" Style="{StaticResource Icone}" FontSize="26" Foreground="{DynamicResource Ok}" HorizontalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtProtTitulo" Text="Verificando a proteção..." FontFamily="{DynamicResource FonteTitulo}" FontSize="20" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="TxtProtDetalhe" Foreground="{DynamicResource TextoSec}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button x:Name="BtnProtAtualizar" Grid.Column="2" Style="{StaticResource BtnFantasma}" Padding="10,6" VerticalAlignment="Top">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource IconeBtn}" FontSize="12"/><TextBlock Text="Atualizar"/></StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <Border x:Name="BannerProtPausada" Background="{DynamicResource AvisoSuave}" CornerRadius="12" Padding="16,12" Margin="0,0,0,14" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icone}" FontSize="20" Foreground="{DynamicResource Aviso}" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="A proteção em tempo real está PAUSADA" FontWeight="SemiBold" Foreground="{DynamicResource Aviso}"/>
                                                <TextBlock x:Name="TxtProtPausadaSub" Foreground="{DynamicResource Aviso}" FontSize="12.5" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button x:Name="BtnProtReativarTopo" Grid.Column="2" Style="{StaticResource BtnPrimario}" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Reativar agora"/></StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="&#xE916;" Style="{StaticResource Icone}" FontSize="16" Foreground="{DynamicResource Acento}" Margin="0,0,10,0"/>
                                                    <TextBlock Text="Pausar a proteção" FontWeight="SemiBold" FontSize="15"/>
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource CorpoSec}" FontSize="13" TextWrapping="Wrap" Text="Para instalar um programa confiável que o antivírus bloqueia por engano. Pausa só a proteção em tempo real e lembra você de reativar."/>
                                                <TextBlock x:Name="TxtProtPausarNota" Foreground="{DynamicResource Aviso}" FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                    <TextBlock Text="Reativar sozinho em:" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextoSec}" Margin="0,0,10,0"/>
                                                    <ComboBox x:Name="CbProtTempo" Width="130" SelectedIndex="1">
                                                        <ComboBoxItem Content="15 minutos" Tag="15"/>
                                                        <ComboBoxItem Content="30 minutos" Tag="30"/>
                                                        <ComboBoxItem Content="1 hora" Tag="60"/>
                                                        <ComboBoxItem Content="Só quando eu clicar" Tag="0"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <Button x:Name="BtnProtPausar" Style="{StaticResource BtnPerigo}" HorizontalAlignment="Left" Margin="0,14,0,0">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE916;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Pausar proteção"/></StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource Card}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="&#xEA18;" Style="{StaticResource Icone}" FontSize="16" Foreground="{DynamicResource Ok}" Margin="0,0,10,0"/>
                                                    <TextBlock Text="Liberar só uma pasta (recomendado)" FontWeight="SemiBold" FontSize="15"/>
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource CorpoSec}" FontSize="13" TextWrapping="Wrap" Text="Mais seguro: em vez de desligar tudo, diz ao antivírus para confiar só numa pasta (ex.: Downloads de um instalador). O resto do PC continua protegido."/>
                                                <Button x:Name="BtnProtExcluir" Style="{StaticResource BtnSecundario}" HorizontalAlignment="Left" Margin="0,14,0,0">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Liberar uma pasta..."/></StackPanel>
                                                </Button>
                                                <ItemsControl x:Name="ListaExclusoes" Margin="0,10,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,3">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                <TextBlock Text="&#xE8B7;" Style="{StaticResource Icone}" FontSize="12" Foreground="{DynamicResource TextoFraco}" Margin="0,0,8,0"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Titulo}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Titulo}"/>
                                                                <Button Grid.Column="2" Style="{StaticResource BtnLink}" Tag="{Binding Titulo}" Content="Remover" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Abrir a Segurança do Windows" FontWeight="SemiBold" FontSize="15"/>
                                            <TextBlock Style="{StaticResource CorpoSec}" FontSize="13" Margin="0,4,0,12" TextWrapping="Wrap" Text="Quando o Windows não deixa pausar por programa (Proteção contra Adulteração ligada), ou quando o antivírus é de outro fabricante, use estes atalhos."/>
                                            <WrapPanel>
                                                <Button x:Name="BtnProtAbrirSeg" Style="{StaticResource BtnSecundario}" Margin="0,0,10,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72E;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Proteção contra vírus"/></StackPanel></Button>
                                                <Button x:Name="BtnProtAbrirTamper" Style="{StaticResource BtnFantasma}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE730;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Proteção contra adulteração"/></StackPanel></Button>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Desinstalar Office -->
                            <ScrollViewer x:Name="FerOffice" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,18">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Border Width="52" Height="52" CornerRadius="14" Background="{DynamicResource AcentoSuave}"><TextBlock Text="&#xE8A5;" Style="{StaticResource Icone}" FontSize="24" Foreground="{DynamicResource Acento}" HorizontalAlignment="Center"/></Border>
                                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Desinstalar o Office" FontFamily="{DynamicResource FonteTitulo}" FontSize="20" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="TxtOfficeResumo" Text="Procurando o Office neste PC..." Foreground="{DynamicResource TextoSec}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button x:Name="BtnOfficeAtualizar" Grid.Column="2" Style="{StaticResource BtnFantasma}" Padding="10,6" VerticalAlignment="Top">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource IconeBtn}" FontSize="12"/><TextBlock Text="Procurar"/></StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtOfficeVazio" Text="Nenhum Office/Microsoft 365 instalado foi encontrado." Foreground="{DynamicResource TextoSec}" Visibility="Collapsed"/>
                                            <ItemsControl x:Name="ListaOffice">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,6">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="&#xE8A5;" Style="{StaticResource Icone}" FontSize="18" Foreground="{DynamicResource Acento}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Texto}" FontSize="12" Foreground="{DynamicResource TextoFraco}"/>
                                                            </StackPanel>
                                                            <Border Grid.Column="2" Style="{StaticResource Chip}" VerticalAlignment="Center"><TextBlock Text="{Binding Tag}" FontSize="11.5" Foreground="{DynamicResource TextoSec}"/></Border>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Border Background="{DynamicResource AvisoSuave}" CornerRadius="10" Padding="14,10" Margin="0,12,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icone}" Foreground="{DynamicResource Aviso}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                                                    <TextBlock Grid.Column="1" Foreground="{DynamicResource Aviso}" TextWrapping="Wrap" Text="Remove o Office inteiro deste PC: Word, Excel, Outlook e os outros. Seus arquivos (.docx, .xlsx) NÃO são apagados. Feche os programas do Office antes. Pode levar alguns minutos."/>
                                                </Grid>
                                            </Border>
                                            <Button x:Name="BtnOfficeDesinstalar" Style="{StaticResource BtnPerigo}" HorizontalAlignment="Left" Margin="0,14,0,0" IsEnabled="False">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Desinstalar o Office completamente"/></StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="2" Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtOfficeStatus" Text="Pronto." FontWeight="SemiBold"/>
                                            <ProgressBar x:Name="BarraOffice" Style="{StaticResource Barra}" Margin="0,10,0,10" Maximum="100"/>
                                            <TextBox x:Name="LogOffice" Style="{StaticResource CampoCodigo}" MinHeight="120"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </ScrollViewer>

                            <!-- Atalhos -->
                            <ScrollViewer x:Name="FerAtalhos" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CorpoSec}" Margin="0,0,0,12" Text="Atalhos para as telas do Windows que todo técnico abre toda hora. Nada aqui altera o sistema sozinho."/>
                                    <ItemsControl x:Name="ListaAtalhos">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource CartaoAcao}" Tag="{Binding Tag}" Padding="0,0,12,12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <Border Style="{StaticResource IconeCirculo}" Width="38" Height="38"><TextBlock Text="{Binding Icone}" Style="{StaticResource Icone}" FontSize="16" Foreground="{DynamicResource Acento}" HorizontalAlignment="Center"/></Border>
                                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Texto}" FontSize="12" Foreground="{DynamicResource TextoSec}" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- ============ VERIFICAR O PC ============ -->
                    <ScrollViewer x:Name="PagVerificar" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.RenderTransform><TranslateTransform/></ScrollViewer.RenderTransform>
                        <StackPanel Margin="36,30,36,36">
                            <TextBlock Style="{StaticResource Titulo}" Text="Verificar o PC"/>
                            <TextBlock Style="{StaticResource Subtitulo}" Text="Confere o que já está otimizado, a segurança, as atualizações, o hardware e a placa de vídeo. Só lê: nada é alterado."/>
                            <Grid Margin="0,22,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Grid Width="150" Height="150">
                                            <Ellipse Stroke="{DynamicResource Superficie2}" StrokeThickness="12"/>
                                            <Path x:Name="ArcoVerificar" Stroke="{DynamicResource AcentoGrad}" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock x:Name="TxtVerNota" Text="?" FontFamily="{DynamicResource FonteTitulo}" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="de 100" FontSize="12" Foreground="{DynamicResource TextoSec}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="TxtVerConceito" Text="Ainda não verificado" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,2"/>
                                        <TextBlock x:Name="TxtVerQuando" Text="Leva uns 20 segundos." Foreground="{DynamicResource TextoSec}" FontSize="12.5" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                        <Button x:Name="BtnVerificar" Style="{StaticResource BtnPrimario}" HorizontalAlignment="Center" Margin="0,14,0,0">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" Style="{StaticResource IconeBtn}"/><TextBlock x:Name="TxtBtnVerificar" Text="Verificar agora"/></StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="O que é verificado" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6"/>
                                        <ItemsControl x:Name="ListaEtapas" ItemTemplate="{StaticResource ModeloEtapa}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid x:Name="PainelVerResumo" Margin="0,16,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Ajustes aplicados por categoria" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                                        <ItemsControl x:Name="ListaCategorias" ItemTemplate="{StaticResource ModeloBarra}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="O que falta" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock x:Name="TxtVerFaltam" FontFamily="{DynamicResource FonteTitulo}" FontSize="40" FontWeight="Bold" Foreground="{DynamicResource Acento}" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="TxtVerFaltamSub" Style="{StaticResource CorpoSec}" FontSize="13"/>
                                        <Button x:Name="BtnVerAplicarFaltam" Style="{StaticResource BtnPrimario}" HorizontalAlignment="Left" Margin="0,14,0,0">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9E9;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Ver e aplicar"/></StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border x:Name="PainelEvolucao" Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Evolução da nota" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock x:Name="TxtEvolucaoResumo" HorizontalAlignment="Right" Foreground="{DynamicResource TextoSec}" FontSize="13"/>
                                    </Grid>
                                    <Grid Height="170" Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="20"/></Grid.RowDefinitions>
                                        <Canvas x:Name="EixoEvolucao" Grid.Row="0"/>
                                        <Canvas x:Name="GraficoEvolucao" Grid.Column="1" Background="Transparent" ClipToBounds="False"/>
                                        <Grid Grid.Row="1" Grid.Column="1">
                                            <TextBlock x:Name="TxtEvolucaoIni" FontSize="11.5" Foreground="{DynamicResource TextoFraco}" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                            <TextBlock x:Name="TxtEvolucaoFim" FontSize="11.5" Foreground="{DynamicResource TextoFraco}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                        </Grid>
                                    </Grid>
                                    <TextBlock x:Name="TxtEvolucaoDica" Style="{StaticResource CorpoSec}" FontSize="12.5" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>                            <TextBlock x:Name="TxtVerSaudeTitulo" Style="{StaticResource Secao}" Text="Saúde do sistema" Visibility="Collapsed"/>
                            <ItemsControl x:Name="ListaSaude" ItemTemplate="{StaticResource ModeloSaude}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ============ PLACA DE VÍDEO ============ -->
                    <ScrollViewer x:Name="PagVideo" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.RenderTransform><TranslateTransform/></ScrollViewer.RenderTransform>
                        <StackPanel Margin="36,30,36,36">
                            <TextBlock Style="{StaticResource Titulo}" Text="Placa de vídeo"/>
                            <TextBlock Style="{StaticResource Subtitulo}" Text="Escolha como você quer jogar. O otimizador ajusta o Windows, e mostra o que conferir no painel da sua placa."/>
                            <Border Style="{StaticResource Card}" Margin="0,22,0,0" Padding="24,20">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="56" Height="56" CornerRadius="16" Background="{DynamicResource AcentoGrad}">
                                            <TextBlock Text="&#xE7F4;" Style="{StaticResource Icone}" FontSize="24" Foreground="White" HorizontalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtGpuNome" Text="Detectando a placa de vídeo..." FontFamily="{DynamicResource FonteTitulo}" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="TxtGpuDetalhe" Foreground="{DynamicResource TextoSec}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="BtnGpuPainel" Style="{StaticResource BtnSecundario}" Margin="0,0,8,0" Visibility="Collapsed">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" Style="{StaticResource IconeBtn}"/><TextBlock x:Name="TxtGpuPainel" Text="Abrir painel"/></StackPanel>
                                            </Button>
                                            <Button x:Name="BtnGpuDriver" Style="{StaticResource BtnFantasma}">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Baixar driver"/></StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <WrapPanel x:Name="PainelMonitores" Margin="0,16,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource Secao}" Text="Como você quer jogar?"/>
                            <UniformGrid Columns="3" Margin="0,0,-10,0">
                                <RadioButton x:Name="RbGpuDesempenho" Style="{StaticResource CartaoEscolha}" GroupName="gpu" Tag="desempenho">
                                    <StackPanel Margin="4">
                                        <Border Style="{StaticResource IconeCirculo}"><TextBlock Text="&#xE945;" Style="{StaticResource Icone}" FontSize="18" Foreground="{DynamicResource Acento}" HorizontalAlignment="Center"/></Border>
                                        <TextBlock Text="Desempenho máximo" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,4"/>
                                        <TextBlock Text="Mais FPS e menor atraso. Para jogos competitivos: CS2, Valorant, Fortnite, LoL." FontSize="12.5" Foreground="{DynamicResource TextoSec}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="RbGpuBalanceado" Style="{StaticResource CartaoEscolha}" GroupName="gpu" Tag="balanceado">
                                    <StackPanel Margin="4">
                                        <Border Style="{StaticResource IconeCirculo}"><TextBlock Text="&#xEC4A;" Style="{StaticResource Icone}" FontSize="18" Foreground="{DynamicResource Acento}" HorizontalAlignment="Center"/></Border>
                                        <TextBlock Text="Balanceado" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,4"/>
                                        <TextBlock Text="Bom FPS sem abrir mão do visual. O melhor para a maioria dos jogos." FontSize="12.5" Foreground="{DynamicResource TextoSec}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="RbGpuQualidade" Style="{StaticResource CartaoEscolha}" GroupName="gpu" Tag="qualidade">
                                    <StackPanel Margin="4">
                                        <Border Style="{StaticResource IconeCirculo}"><TextBlock Text="&#xE790;" Style="{StaticResource Icone}" FontSize="18" Foreground="{DynamicResource Acento}" HorizontalAlignment="Center"/></Border>
                                        <TextBlock Text="Qualidade" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,4"/>
                                        <TextBlock Text="A imagem mais bonita: HDR e filtros no máximo. Para jogos de história e mundo aberto." FontSize="12.5" Foreground="{DynamicResource TextoSec}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="1. No Windows (o otimizador faz)" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtGpuModoDesc" Style="{StaticResource CorpoSec}" FontSize="13" Margin="0,0,0,10" Text="Escolha um modo acima: os ajustes indicados são marcados. Itens já aplicados ficam como estão."/>
                                    <ItemsControl x:Name="ListaGpuAjustes" ItemTemplate="{StaticResource ModeloCartaoAjuste}"/>
                                    <Border Style="{StaticResource Card}" Padding="16,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TxtGpuSelecao" Text="Nenhum ajuste selecionado" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button x:Name="BtnGpuSimular" Style="{StaticResource BtnSecundario}" Margin="0,0,8,0" IsEnabled="False"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7B3;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Simular"/></StackPanel></Button>
                                                <Button x:Name="BtnGpuAplicar" Style="{StaticResource BtnPrimario}" IsEnabled="False"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Aplicar"/></StackPanel></Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="TxtGpuPainelTitulo" Text="2. No painel da placa (você confere)" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
                                    <TextBlock Style="{StaticResource CorpoSec}" FontSize="13" Margin="0,0,0,10" Text="Essas opções ficam no programa do fabricante e o Windows não deixa mudar por fora com segurança. Abra o painel e confira cada uma."/>
                                    <Border Style="{StaticResource Card}" Padding="18,10">
                                        <ItemsControl x:Name="ListaGpuPainel">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,7">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource AcentoSuave}" VerticalAlignment="Top" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding Extra}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Acento}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Texto}" Foreground="{DynamicResource Acento}" FontSize="13" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <TextBlock Style="{StaticResource Secao}" Text="Placa de vídeo por programa"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource CorpoSec}" FontSize="13" VerticalAlignment="Center" Margin="0,0,16,0" Text="Em PCs com duas placas (muito comum em notebooks), escolha um jogo ou programa para rodar sempre na placa de vídeo mais forte."/>
                                        <Button x:Name="BtnGpuAddApp" Grid.Column="1" Style="{StaticResource BtnSecundario}">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Escolher programa (.exe)..."/></StackPanel>
                                        </Button>
                                    </Grid>
                                    <TextBlock x:Name="TxtGpuAppsVazio" Text="Nenhum programa com placa definida." Foreground="{DynamicResource TextoFraco}" Margin="0,12,0,0"/>
                                    <ItemsControl x:Name="ListaGpuApps" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,5">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="&#xE7FC;" Style="{StaticResource Icone}" Foreground="{DynamicResource Acento}" Margin="0,0,12,0"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Tag}" FontSize="12" Foreground="{DynamicResource TextoFraco}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Tag}"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Style="{StaticResource Chip}" Margin="12,0,8,0" VerticalAlignment="Center"><TextBlock Text="{Binding Texto}" FontSize="12" Foreground="{DynamicResource TextoSec}"/></Border>
                                                    <Button Grid.Column="3" Style="{StaticResource BtnLink}" Tag="{Binding Tag}" Content="Remover" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ============ NOTEBOOK ============ -->
                    <ScrollViewer x:Name="PagNotebook" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.RenderTransform><TranslateTransform/></ScrollViewer.RenderTransform>
                        <StackPanel Margin="36,30,36,36">
                            <TextBlock Style="{StaticResource Titulo}" Text="Notebook"/>
                            <TextBlock Style="{StaticResource Subtitulo}" Text="Bateria, tampa e energia: ajustes que só fazem sentido em notebook."/>
                            <Border x:Name="BannerDesktop" Background="{DynamicResource InfoSuave}" CornerRadius="12" Padding="14,10" Margin="0,18,0,0" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE946;" Style="{StaticResource Icone}" Foreground="{DynamicResource Info}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1" Foreground="{DynamicResource Info}" TextWrapping="Wrap" Text="Este PC é um desktop (não tem bateria). Os ajustes abaixo ficam disponíveis quando o otimizador roda num notebook. Use esta página como referência."/>
                                </Grid>
                            </Border>
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE83F;" Style="{StaticResource Icone}" FontSize="16" Foreground="{DynamicResource Acento}" Margin="0,0,10,0"/>
                                            <TextBlock Text="Saúde da bateria" FontWeight="SemiBold" FontSize="15"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtBatSaude" Text="–" FontFamily="{DynamicResource FonteTitulo}" FontSize="44" FontWeight="Bold" Margin="0,8,0,0"/>
                                        <TextBlock x:Name="TxtBatSaudeSub" Text="Lendo a bateria..." Foreground="{DynamicResource TextoSec}" TextWrapping="Wrap"/>
                                        <ProgressBar x:Name="BarraBatSaude" Style="{StaticResource Barra}" Maximum="100" Margin="0,12,0,12"/>
                                        <TextBlock x:Name="TxtBatDetalhe" Style="{StaticResource CorpoSec}" FontSize="12.5"/>
                                        <Button x:Name="BtnBatRelatorio" Style="{StaticResource BtnSecundario}" HorizontalAlignment="Left" Margin="0,14,0,0">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Relatório completo da bateria"/></StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Para a bateria durar mais (anos e horas)" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
                                        <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE945;" Style="{StaticResource Icone}" Foreground="{DynamicResource Acento}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                            <TextBlock Grid.Column="1" Style="{StaticResource Corpo}" FontSize="13" Text="Se o notebook vive na tomada, limite a carga em 80% pelo programa do fabricante (Lenovo Vantage, MyASUS, Dell Power Manager, HP Support Assistant). É o que mais preserva a bateria."/></Grid>
                                        <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xEC4A;" Style="{StaticResource Icone}" Foreground="{DynamicResource Acento}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                            <TextBlock Grid.Column="1" Style="{StaticResource Corpo}" FontSize="13" Text="Na bateria, use o modo de energia &quot;Melhor eficiência de energia&quot; (Configurações > Sistema > Energia e bateria)."/></Grid>
                                        <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE9CA;" Style="{StaticResource Icone}" Foreground="{DynamicResource Acento}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                            <TextBlock Grid.Column="1" Style="{StaticResource Corpo}" FontSize="13" Text="Calor é o maior inimigo da bateria: não use sobre cama ou almofada e mantenha as saídas de ar limpas."/></Grid>
                                        <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE706;" Style="{StaticResource Icone}" Foreground="{DynamicResource Acento}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                            <TextBlock Grid.Column="1" Style="{StaticResource Corpo}" FontSize="13" Text="O brilho da tela é o que mais gasta. Deixe no mínimo confortável."/></Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid Margin="0,28,0,12">
                                <TextBlock Text="Ajustes para notebook" FontWeight="SemiBold" FontSize="16"/>
                                <Button x:Name="BtnNoteRecomendados" Style="{StaticResource BtnFantasma}" HorizontalAlignment="Right" Padding="10,5">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" Style="{StaticResource IconeBtn}" FontSize="12"/><TextBlock Text="Marcar recomendados"/></StackPanel>
                                </Button>
                            </Grid>
                            <ItemsControl x:Name="ListaNoteAjustes" ItemTemplate="{StaticResource ModeloCartaoAjuste}"/>
                            <Border Style="{StaticResource Card}" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtNoteSelecao" Text="Nenhum ajuste selecionado" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="BtnNoteSimular" Style="{StaticResource BtnSecundario}" Margin="0,0,8,0" IsEnabled="False"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7B3;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Simular"/></StackPanel></Button>
                                        <Button x:Name="BtnNoteAplicar" Style="{StaticResource BtnPrimario}" IsEnabled="False"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Aplicar"/></StackPanel></Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ============ SERVIÇOS ============ -->
                    <ScrollViewer x:Name="PagServicos" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.RenderTransform><TranslateTransform/></ScrollViewer.RenderTransform>
                        <StackPanel Margin="36,30,36,36">
                            <TextBlock Style="{StaticResource Titulo}" Text="Serviços"/>
                            <TextBlock Style="{StaticResource Subtitulo}" Text="Serviços do Windows que ficam rodando sem você usar. Desligar os desnecessários libera memória, principalmente em PCs com 8 ou 16 GB."/>
                            <Grid Margin="0,22,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE964;" Style="{StaticResource Icone}" FontSize="16" Foreground="{DynamicResource Acento}" Margin="0,0,10,0"/>
                                            <TextBlock Text="Memória agora" FontWeight="SemiBold" FontSize="15"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtRamUso" Text="–" FontFamily="{DynamicResource FonteTitulo}" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                        <ProgressBar x:Name="BarraRam" Style="{StaticResource Barra}" Maximum="100" Margin="0,10,0,10"/>
                                        <TextBlock x:Name="TxtRamDica" Style="{StaticResource CorpoSec}" FontSize="13"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xEA18;" Style="{StaticResource Icone}" FontSize="16" Foreground="{DynamicResource Ok}" Margin="0,0,10,0"/>
                                            <TextBlock Text="Feito com segurança" FontWeight="SemiBold" FontSize="15"/>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource CorpoSec}" FontSize="13" Margin="0,8,0,0" Text="Só entram serviços que o Windows não precisa para funcionar. Rede, Wi-Fi, áudio, Windows Update e antivírus nunca são mexidos. Cada item mostra quanto de memória usa agora e pode ser desfeito a qualquer momento."/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid Margin="0,28,0,12">
                                <TextBlock Text="Serviços que podem ser desligados" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="BtnServMedir" Style="{StaticResource BtnFantasma}" Padding="10,5" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource IconeBtn}" FontSize="12"/><TextBlock Text="Medir de novo"/></StackPanel>
                                    </Button>
                                    <Button x:Name="BtnServRecomendados" Style="{StaticResource BtnFantasma}" Padding="10,5">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" Style="{StaticResource IconeBtn}" FontSize="12"/><TextBlock Text="Marcar recomendados"/></StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <ItemsControl x:Name="ListaServAjustes" ItemTemplate="{StaticResource ModeloCartaoAjuste}"/>
                            <Border Style="{StaticResource Card}" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtServSelecao" Text="Nenhum serviço selecionado" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="BtnServSimular" Style="{StaticResource BtnSecundario}" Margin="0,0,8,0" IsEnabled="False"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7B3;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Simular"/></StackPanel></Button>
                                        <Button x:Name="BtnServAplicar" Style="{StaticResource BtnPrimario}" IsEnabled="False"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Aplicar"/></StackPanel></Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ============ HISTÓRICO ============ -->
                    <Grid x:Name="PagHistorico" Visibility="Collapsed">
                        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Margin="36,30,36,0">
                            <TextBlock Style="{StaticResource Titulo}" Text="Histórico"/>
                            <TextBlock Style="{StaticResource Subtitulo}" Text="Tudo o que o otimizador já fez neste PC e como voltar atrás."/>
                        </StackPanel>
                        <UniformGrid Grid.Row="1" Columns="3" Margin="36,20,24,6">
                            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Desfazer tudo" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock Style="{StaticResource CorpoSec}" FontSize="13" Margin="0,4,0,12" Text="Volta cada ajuste feito pelo otimizador ao valor exato que tinha antes."/>
                                    <Button x:Name="BtnDesfazerTudo" Style="{StaticResource BtnPerigo}" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7AD;" Style="{StaticResource IconeBtn}"/><TextBlock x:Name="TxtDesfazerTudo" Text="Desfazer todos"/></StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Ponto de restauração" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock Style="{StaticResource CorpoSec}" FontSize="13" Margin="0,4,0,12" Text="Volta o Windows inteiro para uma data anterior. Use se algo der muito errado."/>
                                    <Button x:Name="BtnRstrui" Style="{StaticResource BtnSecundario}" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Abrir restauração"/></StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Arquivos do otimizador" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock Style="{StaticResource CorpoSec}" FontSize="13" Margin="0,4,0,12" Text="Log de cada execução, valores originais e relatórios."/>
                                    <WrapPanel>
                                        <Button x:Name="BtnAbrirDados" Style="{StaticResource BtnSecundario}" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Pasta"/></StackPanel></Button>
                                        <Button x:Name="BtnAbrirLog" Style="{StaticResource BtnFantasma}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7C3;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Log de hoje"/></StackPanel></Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <ScrollViewer Grid.Row="2" Margin="36,14,36,24" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="TxtHistoricoVazio" Text="Nada por aqui ainda. Quando você aplicar ou desfazer ajustes, cada execução aparece nesta lista." Foreground="{DynamicResource TextoSec}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <ItemsControl x:Name="ListaHistorico">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Expander Style="{StaticResource Sanfona}">
                                                <Expander.Header>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource IconeNivel}" Margin="0,0,14,0"/>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Texto}" FontSize="12.5" Foreground="{DynamicResource TextoSec}"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding Extra}" Foreground="{DynamicResource TextoFraco}" FontSize="12.5" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Expander.Header>
                                                <ItemsControl ItemsSource="{Binding Filhos}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,4">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                <TextBlock Style="{StaticResource IconeNivel}" FontSize="13" Margin="0,2,10,0" VerticalAlignment="Top"/>
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Text="{Binding Titulo}"/>
                                                                    <TextBlock Text="{Binding Texto}" FontSize="12" Foreground="{DynamicResource TextoSec}" TextWrapping="Wrap" Visibility="{Binding TemTexto, Converter={StaticResource B2V}}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ============ AJUDA ============ -->
                    <ScrollViewer x:Name="PagAjuda" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.RenderTransform><TranslateTransform/></ScrollViewer.RenderTransform>
                        <StackPanel Margin="36,30,36,36" MaxWidth="980" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource Titulo}" Text="Ajuda"/>
                            <TextBlock Style="{StaticResource Subtitulo}" Text="Tudo explicado sem tecniquês."/>

                            <TextBlock Style="{StaticResource Secao}" Text="Como usar em 3 passos"/>
                            <UniformGrid Columns="3" Margin="0,0,-12,0">
                                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                                    <StackPanel>
                                        <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AcentoGrad}" HorizontalAlignment="Left"><TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <TextBlock Text="Escolha um perfil" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                        <TextBlock Style="{StaticResource CorpoSec}" FontSize="13" Text="Em Otimizar, clique em Básico, Trabalho, Gamer ou PC simples. Os itens indicados são marcados para você. O perfil sugerido aparece no Início."/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                                    <StackPanel>
                                        <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AcentoGrad}" HorizontalAlignment="Left"><TextBlock Text="2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <TextBlock Text="Revise e simule" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                        <TextBlock Style="{StaticResource CorpoSec}" FontSize="13" Text="Clique em cada item para ler o que ele faz. Desmarque o que não quiser. Simular mostra o que mudaria, sem alterar nada."/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                                    <StackPanel>
                                        <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AcentoGrad}" HorizontalAlignment="Left"><TextBlock Text="3" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <TextBlock Text="Aplique e acompanhe" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                        <TextBlock Style="{StaticResource CorpoSec}" FontSize="13" Text="Antes de tudo, um ponto de restauração é criado. Você vê cada item ficar verde (deu certo) ou vermelho (com o motivo do erro)."/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <TextBlock Style="{StaticResource Secao}" Text="Entendendo os sinais"/>
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Risco (bolinha colorida)" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3"><Ellipse Width="9" Height="9" Fill="{DynamicResource Ok}" Margin="0,0,10,0"/><TextBlock Text="Seguro: pode aplicar sem medo" FontSize="13"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,3"><Ellipse Width="9" Height="9" Fill="{DynamicResource Aviso}" Margin="0,0,10,0"/><TextBlock Text="Moderado: leia a seção Atenção" FontSize="13"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,3"><Ellipse Width="9" Height="9" Fill="{DynamicResource Erro}" Margin="0,0,10,0"/><TextBlock Text="Avançado: só se souber o que faz" FontSize="13"/></StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Situação" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3"><Border CornerRadius="99" Padding="9,2" Background="{DynamicResource OkSuave}" Margin="0,0,10,0"><TextBlock Text="Aplicado" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Ok}"/></Border><TextBlock Text="já está assim no PC" FontSize="13" VerticalAlignment="Center"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,3"><Border CornerRadius="99" Padding="9,2" Background="{DynamicResource Superficie2}" Margin="0,0,10,0"><TextBlock Text="Pendente" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextoSec}"/></Border><TextBlock Text="ainda não aplicado" FontSize="13" VerticalAlignment="Center"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,3"><Border CornerRadius="99" Padding="9,2" Background="{DynamicResource AvisoSuave}" Margin="0,0,10,0"><TextBlock Text="Parcial" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Aviso}"/></Border><TextBlock Text="só uma parte está assim" FontSize="13" VerticalAlignment="Center"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,3"><Border CornerRadius="99" Padding="9,2" Background="{DynamicResource InfoSuave}" Margin="0,0,10,0"><TextBlock Text="Ação" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Info}"/></Border><TextBlock Text="limpeza feita na hora" FontSize="13" VerticalAlignment="Center"/></StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Quando vale" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="&#xE72C;" Style="{StaticResource Icone}" FontSize="12" Foreground="{DynamicResource TextoSec}" Margin="0,0,10,0"/><TextBlock Text="precisa reiniciar, sair da conta ou recarregar a barra" FontSize="13" TextWrapping="Wrap" Width="210"/></StackPanel>
                                        <TextBlock Text="O resumo no final mostra exatamente o que fazer, com um botão para isso." FontSize="13" Foreground="{DynamicResource TextoSec}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Style="{StaticResource Secao}" Text="Perguntas frequentes"/>
                            <StackPanel x:Name="PainelFaq"/>

                            <TextBlock Style="{StaticResource Secao}" Text="Glossário: palavras que aparecem no otimizador"/>
                            <Border Style="{StaticResource Card}">
                                <ItemsControl x:Name="ListaGlossario">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,6,18,6">
                                                <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" Foreground="{DynamicResource Acento}"/>
                                                <TextBlock Text="{Binding Texto}" Style="{StaticResource CorpoSec}" FontSize="13"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <TextBlock Style="{StaticResource Secao}" Text="Sobre"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="TxtSobre" Style="{StaticResource Corpo}"/>
                                    <TextBlock x:Name="TxtSobrePasta" Style="{StaticResource CorpoSec}" FontSize="13" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== Execução (sobreposição) ===================== -->
        <Grid x:Name="Overlay" Grid.RowSpan="2" Visibility="Collapsed" Opacity="0">
            <Border Background="{DynamicResource Scrim}"/>
            <Border x:Name="OverlayCartao" Style="{StaticResource Card}" Width="780" MaxHeight="660" Margin="40" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.35" Color="Black"/></Border.Effect>
                <Border.RenderTransform><ScaleTransform x:Name="OverlayEscala" CenterX="390" CenterY="300" ScaleX="0.96" ScaleY="0.96"/></Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="26,24,26,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border x:Name="ExecCirculo" Width="52" Height="52" CornerRadius="16" Background="{DynamicResource AcentoGrad}">
                            <TextBlock x:Name="ExecIcone" Text="&#xE895;" Style="{StaticResource Icone}" FontSize="22" Foreground="White" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform><RotateTransform x:Name="ExecGiro"/></TextBlock.RenderTransform>
                            </TextBlock>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtExecTitulo" Text="Aplicando ajustes" FontFamily="{DynamicResource FonteTitulo}" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtExecSub" Text="" Foreground="{DynamicResource TextoSec}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtExecContagem" Grid.Column="2" FontWeight="SemiBold" Foreground="{DynamicResource TextoSec}" VerticalAlignment="Center"/>
                    </Grid>
                    <ProgressBar x:Name="BarraExec" Grid.Row="1" Style="{StaticResource Barra}" Margin="26,0,26,10" Maximum="100"/>
                    <Grid Grid.Row="2" Margin="14,0,14,0">
                        <ScrollViewer x:Name="RolagemExec" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid x:Name="LinhaPonto" Margin="12,8" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="IcoPonto" Text="&#xE895;" Style="{StaticResource Icone}" FontSize="15" Foreground="{DynamicResource Acento}" Width="22" Margin="0,0,12,0" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform><RotateTransform x:Name="PontoGiro"/></TextBlock.RenderTransform>
                                    </TextBlock>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Ponto de restauração" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtPonto" FontSize="12.5" Foreground="{DynamicResource TextoSec}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                                <ItemsControl x:Name="ListaExec">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="12,7">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock x:Name="Ico" Text="&#xE9F3;" Style="{StaticResource Icone}" FontSize="15" Foreground="{DynamicResource TextoFraco}" Width="22" Margin="0,1,12,0"
                                                           VerticalAlignment="Top" TextAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform><RotateTransform/></TextBlock.RenderTransform>
                                                </TextBlock>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock x:Name="Nome" Text="{Binding Nome}" Foreground="{DynamicResource TextoSec}"/>
                                                    <TextBlock Text="{Binding ExecucaoTexto}" FontSize="12.5" Foreground="{DynamicResource TextoSec}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                               Visibility="{Binding TemExecucaoTexto, Converter={StaticResource B2V}}" x:Name="Msg"/>
                                                </StackPanel>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Execucao}" Value="executando">
                                                    <Setter TargetName="Ico" Property="Text" Value="&#xE895;"/>
                                                    <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource Acento}"/>
                                                    <Setter TargetName="Nome" Property="Foreground" Value="{DynamicResource Texto}"/>
                                                    <Setter TargetName="Nome" Property="FontWeight" Value="SemiBold"/>
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="Giro"><Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="Ico" Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/>
                                                        </Storyboard></BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="Giro"/></DataTrigger.ExitActions>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Execucao}" Value="ok">
                                                    <Setter TargetName="Ico" Property="Text" Value="&#xE73E;"/>
                                                    <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource Ok}"/>
                                                    <Setter TargetName="Nome" Property="Foreground" Value="{DynamicResource Texto}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Execucao}" Value="erro">
                                                    <Setter TargetName="Ico" Property="Text" Value="&#xE711;"/>
                                                    <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource Erro}"/>
                                                    <Setter TargetName="Nome" Property="Foreground" Value="{DynamicResource Texto}"/>
                                                    <Setter TargetName="Msg" Property="Foreground" Value="{DynamicResource Erro}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Execucao}" Value="aviso">
                                                    <Setter TargetName="Ico" Property="Text" Value="&#xE7BA;"/>
                                                    <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource Aviso}"/>
                                                    <Setter TargetName="Nome" Property="Foreground" Value="{DynamicResource Texto}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Execucao}" Value="ignorado">
                                                    <Setter TargetName="Ico" Property="Text" Value="&#xE711;"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Execucao}" Value="simulado">
                                                    <Setter TargetName="Ico" Property="Text" Value="&#xE7B3;"/>
                                                    <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource Info}"/>
                                                    <Setter TargetName="Nome" Property="Foreground" Value="{DynamicResource Texto}"/>
                                                    <Setter TargetName="Msg" Property="FontFamily" Value="{DynamicResource FonteCodigo}"/>
                                                    <Setter TargetName="Msg" Property="FontSize" Value="12"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                        <TextBox x:Name="LogExec" Style="{StaticResource CampoCodigo}" Visibility="Collapsed" Margin="12,0"/>
                    </Grid>
                    <Border Grid.Row="3" Background="{DynamicResource Superficie2}" CornerRadius="0,0,14,14" Padding="22,16" Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ToggleButton x:Name="BtnExecLog" Cursor="Hand" FocusVisualStyle="{x:Null}" VerticalAlignment="Center">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="B" Background="Transparent" CornerRadius="8" Padding="10,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7C3;" Style="{StaticResource Icone}" FontSize="13" Foreground="{DynamicResource TextoSec}" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="T" Text="Ver log técnico" Foreground="{DynamicResource TextoSec}" FontSize="13"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Superficie}"/></Trigger>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="T" Property="Text" Value="Ver lista"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <WrapPanel x:Name="PainelResumo" Grid.Column="1" VerticalAlignment="Center" Margin="12,0" Visibility="Collapsed">
                                <Border x:Name="ChipOk" CornerRadius="99" Padding="10,3" Background="{DynamicResource OkSuave}" Margin="0,0,6,0"><TextBlock x:Name="TxtChipOk" Foreground="{DynamicResource Ok}" FontWeight="SemiBold" FontSize="12.5"/></Border>
                                <Border x:Name="ChipErro" CornerRadius="99" Padding="10,3" Background="{DynamicResource ErroSuave}" Margin="0,0,6,0"><TextBlock x:Name="TxtChipErro" Foreground="{DynamicResource Erro}" FontWeight="SemiBold" FontSize="12.5"/></Border>
                                <Border x:Name="ChipAviso" CornerRadius="99" Padding="10,3" Background="{DynamicResource AvisoSuave}" Margin="0,0,6,0"><TextBlock x:Name="TxtChipAviso" Foreground="{DynamicResource Aviso}" FontWeight="SemiBold" FontSize="12.5"/></Border>
                            </WrapPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button x:Name="BtnExecLogoff" Style="{StaticResource BtnSecundario}" Margin="0,0,8,0" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE77B;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Sair da conta agora"/></StackPanel>
                                </Button>
                                <Button x:Name="BtnExecReiniciar" Style="{StaticResource BtnPrimario}" Margin="0,0,8,0" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7E8;" Style="{StaticResource IconeBtn}"/><TextBlock Text="Reiniciar agora"/></StackPanel>
                                </Button>
                                <Button x:Name="BtnExecFechar" Style="{StaticResource BtnSecundario}" IsEnabled="False">
                                    <TextBlock x:Name="TxtExecFechar" Text="Aguarde..."/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== Diálogo de confirmação ===================== -->
        <Grid x:Name="Dialogo" Grid.RowSpan="2" Visibility="Collapsed">
            <Border Background="{DynamicResource Scrim}"/>
            <Border Style="{StaticResource Card}" Width="560" MaxHeight="600" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.35" Color="Black"/></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="26,24,26,8">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="DlgCirculo" Width="40" Height="40" CornerRadius="12" Background="{DynamicResource AcentoSuave}">
                                <TextBlock x:Name="DlgIcone" Text="&#xE946;" Style="{StaticResource Icone}" FontSize="18" Foreground="{DynamicResource Acento}" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="TxtDlgTitulo" FontFamily="{DynamicResource FonteTitulo}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap" MaxWidth="440"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtDlgTexto" Style="{StaticResource CorpoSec}" Margin="0,14,0,0"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" Margin="26,4,26,0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ListaDlg">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource IconeNivel}" FontSize="14" Margin="0,2,10,0" VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Texto}" FontSize="12.5" Foreground="{DynamicResource TextoSec}" TextWrapping="Wrap" Visibility="{Binding TemTexto, Converter={StaticResource B2V}}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="26,18,26,22">
                        <Button x:Name="BtnDlgCancelar" Style="{StaticResource BtnFantasma}" Content="Cancelar" Margin="0,0,10,0"/>
                        <Button x:Name="BtnDlgOk" Style="{StaticResource BtnPrimario}"><TextBlock x:Name="TxtDlgOk" Text="Confirmar"/></Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== Notificação (toast) ===================== -->
        <Border x:Name="Toast" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28"
                Background="{DynamicResource Superficie2}" BorderBrush="{DynamicResource Borda}" BorderThickness="1" CornerRadius="12" Padding="16,12"
                Opacity="0" IsHitTestVisible="False" MaxWidth="420">
            <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.3" Color="Black"/></Border.Effect>
            <Border.RenderTransform><TranslateTransform x:Name="ToastT" Y="30"/></Border.RenderTransform>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastIcone" Text="&#xE73E;" Style="{StaticResource Icone}" FontSize="16" Foreground="{DynamicResource Ok}" Margin="0,0,12,0" VerticalAlignment="Top"/>
                <TextBlock x:Name="ToastTexto" TextWrapping="Wrap" MaxWidth="360"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
